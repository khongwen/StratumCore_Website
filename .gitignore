# IndexNow verification file, written into public/ at build time from
# INDEXNOW_KEY. The key is a Vercel environment variable, not repo content.
public/*.txt
!public/llms.txt
!public/llms-full.txt
!public/robots.txt

# astro-indexnow change-detection cache. Vercel builds from a clean checkout,
# so this is always local-only; every deploy submits the full URL set, which is
# what we want while the site is being discovered.
.astro-indexnow-cache.json

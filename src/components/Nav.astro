---
const pathname = Astro.url.pathname;

const servicePaths = [
  '/cost-reduction',
  '/financial-control-governance',
  '/finance-team-building',
  '/leadership-development',
  '/finance-business-partner-academy',
  '/corporate-advisory',
];

const isHome     = pathname === '/';
const isServices = servicePaths.some(p => pathname.startsWith(p));
const isAbout    = pathname.startsWith('/about');

const start = (p) => pathname.startsWith(p);
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <div class="max-w-site mx-auto px-6 lg:px-10 h-full flex items-center justify-between gap-8">

    <!-- Wordmark -->
    <a href="/" class="wordmark" aria-label="StratumCore home">
      <span class="part-stratum">Stratum</span><span class="part-core">Core</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-7" aria-label="Main navigation">

      <a href="/" class={`nav-link${isHome ? ' is-active' : ''}`}>Home</a>

      <!-- Services dropdown -->
      <div class="dropdown-parent flex items-center">
        <button
          class={`nav-link flex items-center cursor-default select-none${isServices ? ' is-active' : ''}`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg class="chevron" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="dropdown-menu" role="menu">
          <a href="/cost-reduction"
             class={`dropdown-link${start('/cost-reduction') ? ' is-active' : ''}`}
             role="menuitem">Cost Reduction</a>
          <a href="/financial-control-governance"
             class={`dropdown-link${start('/financial-control-governance') ? ' is-active' : ''}`}
             role="menuitem">Financial Control</a>
          <a href="/finance-team-building"
             class={`dropdown-link${(start('/finance-team-building') || start('/leadership-development') || start('/finance-business-partner-academy')) ? ' is-active' : ''}`}
             role="menuitem">Finance Team Building</a>
        </div>
      </div>

      <a href="/about" class={`nav-link${isAbout ? ' is-active' : ''}`}>About</a>

    </nav>

    <!-- Right: CTA + hamburger -->
    <div class="flex items-center gap-4">
      <a href="/#contact" class="hidden lg:inline-block btn-book-call">
        Book a Call
      </a>

      <button id="mob-toggle" class="hamburger lg:hidden" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>

  <!-- Mobile menu (collapsed by default) -->
  <div id="mob-menu" class="hidden lg:hidden" aria-hidden="true">

    <a href="/" class={`mob-nav-link${isHome ? ' is-active' : ''}`}>Home</a>

    <!-- Services accordion -->
    <button class="mob-services-toggle js-mob-acc" aria-expanded="false">
      Services
      <svg class="mob-services-chevron" width="14" height="14" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="mob-submenu hidden">
      <a href="/cost-reduction">Cost Reduction</a>
      <a href="/financial-control-governance">Financial Control</a>
      <a href="/finance-team-building">Finance Team Building</a>
    </div>

    <a href="/about" class={`mob-nav-link${isAbout ? ' is-active' : ''}`}>About</a>

    <div class="mob-cta-wrap">
      <a href="/#contact" class="btn-book-call block text-center">Book a Call</a>
    </div>

  </div>
</header>

<script>
  // ── Scroll effect ──────────────────────────────────────────────
  const nav = document.getElementById('site-nav')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Mobile hamburger toggle ────────────────────────────────────
  const toggle  = document.getElementById('mob-toggle')!;
  const mobMenu = document.getElementById('mob-menu')!;

  toggle.addEventListener('click', () => {
    const isOpen = !mobMenu.classList.contains('hidden');
    mobMenu.classList.toggle('hidden', isOpen);
    mobMenu.setAttribute('aria-hidden', String(isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.classList.toggle('open', !isOpen);
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!nav.contains(e.target as Node)) {
      mobMenu.classList.add('hidden');
      mobMenu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.classList.remove('open');
    }
  });

  // ── Mobile accordions ─────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.js-mob-acc').forEach((btn) => {
    const submenu = btn.nextElementSibling as HTMLElement | null;
    if (!submenu) return;
    btn.addEventListener('click', () => {
      const isOpen = !submenu.classList.contains('hidden');
      submenu.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.classList.toggle('open', !isOpen);
    });
  });

  // Close mobile menu when a link is clicked
  mobMenu.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      mobMenu.classList.add('hidden');
      toggle.classList.remove('open');
    })
  );
</script>

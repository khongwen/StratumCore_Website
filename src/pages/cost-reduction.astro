---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { graph, organization, founder, service, faqPage, breadcrumb } from '../lib/seo';

const blocks = [
  {
    n: '01',
    thesis: 'Most organisations don’t have a cost problem. They have a clarity problem.',
    points: [
      'Day-to-day demands make it difficult to see the operation clearly.',
      'Teams are busy solving today’s issues, managing today’s priorities and responding to today’s pressures.',
      'The result is often more activity, more initiatives and more reporting — but not necessarily better outcomes.',
    ],
    action: 'We help leaders step back, follow the facts, and identify the few things that genuinely drive performance.',
    because: 'Because better outcomes start with better clarity.',
  },
  {
    n: '02',
    thesis: 'Your leaders don’t need more initiatives. They need better priorities.',
    points: [
      'Every operation has a list of opportunities. The challenge is rarely finding things to do.',
      'The real challenge is knowing which opportunities will create meaningful value — and which will simply consume time, resources and attention.',
    ],
    action: 'We help leaders focus on the few changes that genuinely move productivity, cost and performance.',
    because: 'Because value comes from execution, not activity.',
  },
  {
    n: '03',
    thesis: 'Your team is capable of more than they realise.',
    points: [
      'The pressure of day-to-day operations can make it difficult to step back and see what is truly possible.',
      'The people, assets and opportunities are often already there.',
      'The question is not whether improvement is possible. The question is: what is this organisation truly capable of becoming?',
    ],
    action: 'Our role is to help leaders answer that question — by uncovering constraints, challenging conventional thinking, and identifying the opportunities that will have the greatest impact.',
    because: 'Because the highest-performing organisations are not always the ones with the most resources. They’re the ones that understand their potential and have the discipline to pursue it.',
  },
];

const faqs = [
  {
    q: 'Who are the top consultants who specialise in mining cost reduction?',
    a: 'StratumCore is an independent finance advisory specialising in cost reduction for mining, resources and asset-intensive businesses. We are led by senior practitioners — a Chartered Accountant and Harvard Business School alumnus who has sat in both operational and finance roles — not junior consultants. Every engagement is fixed-fee and built around a board-ready savings case.',
  },
  {
    q: 'How do you reduce mining operating costs?',
    a: 'We start with a fixed-fee diagnostic that benchmarks your unit cost (cost per tonne) against the field and follows the facts to where cost is genuinely created. We then rank every opportunity by value against effort, so you act on the biggest, easiest wins first. The result is a prioritised, defensible plan rather than a longer list of initiatives.',
  },
  {
    q: 'How much cost can a diagnostic realistically remove?',
    a: 'Most operations can unlock 15% or more in productivity and unit cost gains from their existing assets, without adding headcount. We size the likely range for your operation before you commit. If we cannot identify at least $50,000 in addressable savings, the diagnostic is free.',
  },
  {
    q: 'How long does a cost diagnostic take?',
    a: 'The standard diagnostic runs over five weeks and ends with a costed, initiative-by-initiative pathway to a lower unit cost. You receive a benchmarked cost position, a prioritised set of initiatives ranked by value against effort, and a board-ready savings case you can act on immediately.',
  },
];

const schema = graph(
  organization,
  founder,
  service({
    id: 'https://www.stratumcore.com.au/cost-reduction/#service',
    name: 'Mining Cost Reduction',
    serviceType: 'Mining cost reduction',
    description: 'A fixed-fee cost diagnostic that benchmarks unit cost against the field and delivers a prioritised, board-ready savings case in five weeks.',
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home',               url: 'https://www.stratumcore.com.au/' },
    { name: 'Corporate Advisory', url: 'https://www.stratumcore.com.au/corporate-advisory' },
    { name: 'Cost Reduction',     url: 'https://www.stratumcore.com.au/cost-reduction' },
  ]),
);
---

<BaseLayout
  title="Cost Reduction — 15%+ Productivity & Unit Cost Gains | StratumCore"
  description="15%+ productivity and unit cost gains from your existing operation. A fixed-fee cost diagnostic that benchmarks your unit cost and delivers a board-ready savings case in 5 weeks."
  canonical="https://www.stratumcore.com.au/cost-reduction"
  ogImage="https://www.stratumcore.com.au/og-image-home.png"
  ogImageAlt="Cost Reduction — StratumCore"
  schema={schema}
>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════
       1. PAGE HERO
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark flex items-end relative overflow-hidden"
    style="min-height: 72vh;"
    aria-label="Cost Reduction"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background-image:
          radial-gradient(ellipse 60% 65% at 95% 5%,  rgba(0,201,187,0.07) 0%, transparent 55%),
          radial-gradient(ellipse 40% 50% at 0%  90%, rgba(212,117,26,0.04) 0%, transparent 50%),
          linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
        background-size: auto, auto, 72px 72px, 72px 72px;
      "
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 pb-20 pt-[calc(72px+2.5rem)] w-full">
      <div class="max-w-4xl">

        <p class="page-label mb-6">Corporate Advisory &nbsp;·&nbsp; Cost Reduction</p>
        <span class="teal-rule mb-8 block"></span>

        <h1
          class="hero-h1 font-serif font-bold text-white mb-0"
        >
          15%+ productivity and unit cost gains from your existing&nbsp;operation.
        </h1>

        <p
          class="font-sans mt-8 leading-relaxed"
          style="font-size: clamp(1rem, 1.35vw, 1.1875rem); color: var(--on-dark-2); line-height: 1.7; max-width: 36rem;"
        >
          A fixed-fee cost diagnostic that benchmarks your unit cost against the field and
          hands you a board-ready savings case in
          <strong style="color: rgba(255,255,255,0.92); font-weight: 700;">5 weeks</strong>.
          Run by experienced partners &mdash; not junior staff.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-4">
          <a href="/#contact" class="btn-primary cta-lg">Book my cost review</a>
          <span class="font-sans" style="font-size: 0.875rem; color: var(--on-dark-3); line-height: 1.5; max-width: 18rem;">
            30&nbsp;minutes. No obligation. We come prepared with a savings range for your operation.
          </span>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. THE THESIS — three editorial narrative blocks
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="How we think about cost">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="mb-16 lg:mb-20 fade-up">
        <p class="page-label mb-4" style="color: var(--accent);">How we think about cost</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 30rem;"
        >
          The gains are already in your operation. We help you see them.
        </h2>
      </div>

      <div class="divide-y" style="border-color: var(--hairline);">
        {blocks.map((b, i) => (
          <article
            class="thesis-row grid lg:grid-cols-12 gap-8 lg:gap-16 py-12 lg:py-16 fade-up"
          >
            <!-- Left: number + thesis -->
            <div class="lg:col-span-5">
              <p class="thesis-num mb-5">{b.n}</p>
              <h3
                class="font-serif font-bold text-body"
                style="font-size: clamp(1.375rem, 2.2vw, 2rem); letter-spacing: -0.025em; line-height: 1.18; max-width: 24rem;"
              >
                {b.thesis}
              </h3>
            </div>

            <!-- Right: supporting points + action + because -->
            <div class="lg:col-span-7 lg:pt-2">
              <ul class="space-y-4 mb-8" role="list">
                {b.points.map((p) => (
                  <li class="font-sans flex items-start gap-3.5" style="font-size: 1.0625rem; color: var(--body); line-height: 1.75; max-width: 38rem;">
                    <span aria-hidden="true" style="display:inline-block; flex-shrink:0; width:6px; height:6px; border-radius:50%; background:var(--accent); margin-top:0.7em;"></span>
                    {p}
                  </li>
                ))}
              </ul>

              <p
                class="font-sans font-bold text-body mb-6"
                style="font-size: clamp(1.0625rem, 1.4vw, 1.1875rem); letter-spacing: -0.01em; line-height: 1.6; max-width: 38rem;"
              >
                {b.action}
              </p>

              <blockquote
                class="font-serif pl-6"
                style="border-left: 3px solid var(--accent); font-size: clamp(1.0625rem, 1.4vw, 1.25rem); color: var(--ink); font-style: italic; letter-spacing: -0.01em; line-height: 1.5; max-width: 36rem;"
              >
                {b.because}
              </blockquote>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. THE DIAGNOSTIC — what you get (proof assets)
  ══════════════════════════════════════════════════════════ -->
  <section class="py-24 lg:py-32" style="background: var(--bg-alt);" aria-label="The cost diagnostic">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="max-w-3xl fade-up">
        <p class="page-label mb-4" style="color: var(--accent);">The cost diagnostic</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3.5vw, 3rem); letter-spacing: -0.025em; line-height: 1.12;"
        >
          Know where your savings are before you spend a dollar.
        </h2>
        <p
          class="font-sans mt-6 leading-relaxed"
          style="font-size: 1.0625rem; color: var(--body); line-height: 1.8;"
        >
          A fixed-fee, five-week diagnostic that turns the facts into a prioritised, defensible
          plan. If we don&rsquo;t identify at least $50K in addressable savings, the diagnostic is free.
        </p>
      </div>

      <!-- Three deliverables -->
      <div class="grid sm:grid-cols-3 gap-px mt-14 fade-up" style="background: var(--hairline);">
        <div class="section-alt p-7 lg:p-8 deliverable">
          <p class="deliverable__k">01</p>
          <h3 class="deliverable__h">Benchmarked unit cost</h3>
          <p class="deliverable__b">Your cost per tonne placed against the field, broken down to where you actually sit high.</p>
        </div>
        <div class="section-alt p-7 lg:p-8 deliverable">
          <p class="deliverable__k">02</p>
          <h3 class="deliverable__h">Prioritised initiatives</h3>
          <p class="deliverable__b">Every saving ranked by dollar value against the effort to capture it — biggest wins first.</p>
        </div>
        <div class="section-alt p-7 lg:p-8 deliverable">
          <p class="deliverable__k">03</p>
          <h3 class="deliverable__h">Board-ready case</h3>
          <p class="deliverable__b">A defensible savings case in 5 weeks — numbers that withstand executive and board scrutiny.</p>
        </div>
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3c. FAQ — answer-shaped, drives FAQPage schema
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="Common questions">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <p class="page-label mb-12 lg:mb-14 fade-up" style="color:var(--accent);">Common questions</p>
      <div class="divide-y" style="border-color:var(--hairline);">
        {faqs.map((f) => (
          <div class="grid lg:grid-cols-12 gap-4 lg:gap-12 py-9 lg:py-11 fade-up">
            <h2 class="lg:col-span-5 font-serif font-bold text-body" style="font-size: clamp(1.2rem, 1.7vw, 1.55rem); letter-spacing: -0.02em; line-height: 1.25;">
              {f.q}
            </h2>
            <p class="lg:col-span-7 font-sans" style="font-size: 1.0625rem; color: var(--body); line-height: 1.8;">
              {f.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. CLOSING CTA
  ══════════════════════════════════════════════════════════ -->
  <section
    class="section-alt relative"
    aria-label="Contact"
  >

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 text-center fade-up">
      <h2
        class="font-serif font-bold mb-8 mx-auto"
        style="font-size: clamp(1.75rem, 3.5vw, 3rem); color: var(--ink); letter-spacing: -0.025em; line-height: 1.2; max-width: 36rem;"
      >
        Find out what your operation is truly capable of.
      </h2>
      <a
        href="/#contact"
        class="font-sans font-bold inline-flex items-center gap-3 px-8 py-4 rounded-sm"
        style="background: var(--accent); color: var(--accent-fg); font-size: 0.9375rem; letter-spacing: 0.02em; text-decoration: none; transition: background 0.18s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1);"
        onmouseover="this.style.background=\'var(--accent-strong)\'; this.style.transform=\'translateY(-2px)\'"
        onmouseout="this.style.background=\'var(--accent)\'; this.style.transform=\'translateY(0)\'"
      >
        Book my cost review
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p
        class="font-sans mt-5"
        style="font-size: 0.875rem; color: var(--muted);"
      >
        wen@stratumcore.com.au &nbsp;·&nbsp; Brisbane, QLD, Australia
      </p>
    </div>
  </section>

  <Footer />

</BaseLayout>

<style>
  .cta-lg {
    padding: 0.95rem 2.1rem; font-size: 1rem; min-height: 48px;
    display: inline-flex; align-items: center;
  }

  .thesis-num {
    font-family: var(--font-body); font-weight: 700; font-size: 0.75rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }

  /* Deliverables */
  .deliverable { border-top: 2px solid var(--hairline); transition: border-color 0.22s ease; }
  .deliverable:hover { border-top-color: var(--accent); }
  .deliverable__k {
    font-family: var(--font-body); font-weight: 700; font-size: 0.6875rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.1rem;
  }
  .deliverable__h {
    font-family: var(--font-body); font-weight: 700; color: var(--ink); margin-bottom: 0.6rem;
    font-size: 1.1875rem; letter-spacing: -0.015em; line-height: 1.2;
  }
  .deliverable__b {
    font-family: var(--font-body); font-size: 0.9375rem; color: var(--body); line-height: 1.7;
  }
</style>

<script>
  // Scroll reveal. Grouped siblings stagger off --i so cards arrive in
  // sequence rather than together. The hero carries no .fade-up at all, so it
  // paints at full opacity on first frame.
  const reveal = () => {
    const items = [...document.querySelectorAll('.fade-up')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('visible'));
      return;
    }
    items.forEach(el => {
      const sibs = [...(el.parentElement?.children ?? [])].filter(n => n.classList.contains('fade-up'));
      if (sibs.length > 1) el.style.setProperty('--i', String(sibs.indexOf(el)));
    });

    // Anything already on screen at load is shown immediately, with no
    // transition, so the first viewport is never caught mid-fade.
    const vh = window.innerHeight;
    items.forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) { el.style.setProperty('--i', '0'); el.classList.add('instant', 'visible'); }
    });

    // rootMargin fires the reveal a screen-worth early, so an element is
    // already at full opacity by the time it is actually scrolled into view.
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        // If it is already well inside the viewport, a fast scroll outran the
        // observer — skip the transition rather than fade it in late.
        const r = e.target.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.75) e.target.classList.add('instant');
        e.target.classList.add('visible');
        io.unobserve(e.target);
      });
    }, { threshold: 0, rootMargin: '0px 0px 45% 0px' });
    items.forEach(el => { if (!el.classList.contains('visible')) io.observe(el); });
  };
  reveal();
</script>

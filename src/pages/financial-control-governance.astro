---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { graph, organization, founder, service, faqPage, breadcrumb } from '../lib/seo';

const tiles = [
  {
    n: '01',
    title: 'Spend control & procurement discipline',
    body: 'Get a real handle on operational and capital spend — approval thresholds, commitment controls, and supplier discipline that hold as you scale.',
  },
  {
    n: '02',
    title: 'Financial visibility & reporting',
    body: 'Reporting that gives the board and executive a clear, timely view of performance — not a month-end scramble for numbers nobody trusts.',
  },
  {
    n: '03',
    title: 'Policies, processes & delegations',
    body: 'The policies, procedures and delegations of authority that let the business run without bottlenecks — and without everything routing through one person.',
  },
  {
    n: '04',
    title: 'Governance & board-grade rigour',
    body: 'Decision rights, controls and reporting cadences that stand up to a board, an investor, a lender, or a buyer.',
  },
  {
    n: '05',
    title: 'Planning, budgeting & forecasting',
    body: 'A planning rhythm that reflects operational reality — so the budget is a tool you steer with, not a document you file.',
  },
  {
    n: '06',
    title: 'Finance function design',
    body: 'Structure, roles and systems sized for where the business is going — so finance scales with you, not behind you.',
  },
];

const faqs = [
  {
    q: 'What is financial control and governance advisory?',
    a: 'It is the work of putting the right controls, reporting and decision rights in place so a business can scale without losing visibility or control. StratumCore helps fast-grown businesses get a real handle on operational spend, clear visibility into performance, and the policies and processes that remove bottlenecks. We stay involved so the changes land and hold.',
  },
  {
    q: 'How do I get control of spending in a fast-growing business?',
    a: 'Start with approval thresholds, commitment controls and procurement discipline that hold as volumes rise, rather than spend approved on trust. We then make sure reporting gives the board and executive a timely, trusted view of where the money is going. The aim is to move quickly and stay in control at the same time.',
  },
  {
    q: 'When does a growing business need stronger financial governance?',
    a: 'Usually when decisions bottleneck around one or two people, month-end is a scramble, or a board, investor or lender starts asking for rigour you do not yet have. If two or three of those ring true, it is time to put the foundations in place before the next stage of growth.',
  },
  {
    q: 'What does StratumCore put in place?',
    a: 'Spend controls and procurement discipline, financial reporting and visibility, policies, processes and delegations of authority, board-grade governance, a practical planning and forecasting rhythm, and a finance function sized for where the business is going. Each engagement is scoped to the few changes that will matter most first.',
  },
];

const schema = graph(
  organization,
  founder,
  service({
    id: 'https://www.stratumcore.com.au/financial-control-governance/#service',
    name: 'Financial Control & Governance',
    serviceType: 'Financial control advisory',
    description: 'Helping fast-grown businesses get control of operational spend, visibility into performance, and the policies and governance needed to scale without bottlenecks.',
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home',                           url: 'https://www.stratumcore.com.au/' },
    { name: 'Corporate Advisory',             url: 'https://www.stratumcore.com.au/corporate-advisory' },
    { name: 'Financial Control & Governance', url: 'https://www.stratumcore.com.au/financial-control-governance' },
  ]),
);
---

<BaseLayout
  title="Financial Control & Governance — Scale Without Bottlenecks | StratumCore"
  description="Grown fast? We help businesses get control of operational spend, clear visibility into financial performance, and the policies and governance needed to scale without bottlenecks."
  canonical="https://www.stratumcore.com.au/financial-control-governance"
  ogImageAlt="Financial Control & Governance — StratumCore"
  schema={schema}
>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════
       1. PAGE HERO
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark flex items-end relative overflow-hidden"
    style="min-height: 72vh;"
    aria-label="Financial Control and Governance"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background-image:
          radial-gradient(ellipse 55% 60% at 100% 0%,  rgba(0,201,187,0.06) 0%, transparent 55%),
          radial-gradient(ellipse 35% 45% at 0%  100%, rgba(212,117,26,0.04) 0%, transparent 50%),
          linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
        background-size: auto, auto, 72px 72px, 72px 72px;
      "
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 pb-20 pt-[calc(72px+2.5rem)] w-full">
      <div class="max-w-4xl fade-up">

        <p class="page-label mb-6">Corporate Advisory &nbsp;·&nbsp; Financial Control &amp; Governance</p>
        <span class="teal-rule mb-8 block"></span>

        <h1
          class="font-serif font-bold text-white mb-0"
          style="font-size: clamp(2.1rem, 4.4vw, 4.25rem); letter-spacing: -0.03em; max-width: 38rem; line-height: 1.06;"
        >
          You scaled fast. Now make the <span style="color:#00C9BB;">financials keep up.</span>
        </h1>

        <p
          class="font-serif mt-7 leading-relaxed"
          style="font-size: clamp(1rem, 1.35vw, 1.1875rem); color: rgba(255,255,255,0.62); line-height: 1.7; max-width: 37rem;"
        >
          When a business grows quickly, the financial controls and governance rarely keep
          pace. We help you get a real handle on spend, clear visibility into performance, and
          the policies and processes that let the business run &mdash; without bottlenecks.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-4">
          <a href="/#contact" class="btn-primary cta-lg">Book a call</a>
          <span class="font-serif" style="font-size: 0.875rem; color: rgba(255,255,255,0.45); line-height: 1.5; max-width: 18rem;">
            A focused conversation about where control is slipping &mdash; and what to fix first.
          </span>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. THE PROBLEM — editorial two-column
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-white py-24 lg:py-32" aria-label="The challenge of fast growth">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <div class="fade-up">
          <p class="page-label mb-5" style="color: #00C9BB;">The challenge of fast growth</p>
          <h2
            class="font-serif font-bold text-body"
            style="font-size: clamp(1.75rem, 3.2vw, 3rem); letter-spacing: -0.03em; line-height: 1.08; max-width: 24rem;"
          >
            Growth hides the cracks. Until it doesn&rsquo;t.
          </h2>
        </div>

        <div class="fade-up lg:pt-2" style="transition-delay: 80ms;">
          <div class="mb-8" style="width: 3rem; height: 2px; background: #00C9BB; border-radius: 1px;"></div>
          <p
            class="font-serif leading-relaxed mb-6"
            style="font-size: clamp(1rem, 1.4vw, 1.125rem); color: rgba(34,34,34,0.75); line-height: 1.85;"
          >
            The systems and habits that got the business off the ground rarely survive
            the scale-up. Spend creeps. Approvals live in someone&rsquo;s inbox. The numbers
            arrive late and nobody quite trusts them. Decisions bottleneck around the few
            people who hold it all in their heads.
          </p>
          <p
            class="font-serif leading-relaxed"
            style="font-size: clamp(1rem, 1.4vw, 1.125rem); color: rgba(34,34,34,0.75); line-height: 1.85;"
          >
            None of it is a crisis &mdash; until a board, an investor, or a bad month makes it
            one. The fix isn&rsquo;t more reporting. It&rsquo;s the right controls, set at the right
            level, so the business can move quickly and stay in control at the same time.
          </p>

          <blockquote
            class="mt-10 pl-6 font-serif font-bold"
            style="border-left: 3px solid #00C9BB; font-size: clamp(1.1rem, 1.6vw, 1.375rem); color: #1C1C1E; letter-spacing: -0.015em; line-height: 1.4;"
          >
            &ldquo;Strong controls aren&rsquo;t a brake on the business. They&rsquo;re what lets you put your foot down.&rdquo;
          </blockquote>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. WHAT WE PUT IN PLACE — service tiles
  ══════════════════════════════════════════════════════════ -->
  <section class="py-24 lg:py-32" style="background: #F2F2F2;" aria-label="What we put in place">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="mb-16 fade-up">
        <p class="page-label mb-4">What we put in place</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 28rem;"
        >
          The financial backbone of a business built to scale.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px" style="background: #DCDCDC;">
        {tiles.map((t) => (
          <article class="service-tile bg-stone p-8 lg:p-10 fade-up">
            <p class="tile-number mb-5">{t.n}</p>
            <h3 class="font-serif font-bold text-body mb-3" style="font-size: clamp(1.125rem, 1.5vw, 1.375rem); letter-spacing: -0.02em; line-height: 1.2;">
              {t.title}
            </h3>
            <p class="font-serif leading-relaxed" style="font-size: 0.9375rem; color: rgba(34,34,34,0.62); line-height: 1.75;">
              {t.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. SIGNS YOU NEED THIS — dark, two-column bullets
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark py-24 lg:py-32 relative overflow-hidden"
    style="background-color: #1C1C1E; background-image: radial-gradient(ellipse 60% 70% at 50% 110%, rgba(0,201,187,0.05) 0%, transparent 60%);"
    aria-label="Signs you have outgrown your controls"
  >
    <div class="max-w-site mx-auto px-6 lg:px-10 relative z-10">

      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <div class="fade-up">
          <p class="page-label mb-4">Sound familiar?</p>
          <h2
            class="font-serif font-bold text-white"
            style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 22rem;"
          >
            Signs you&rsquo;ve outgrown your controls.
          </h2>
          <p
            class="font-serif mt-6 leading-relaxed"
            style="font-size: 1rem; color: rgba(255,255,255,0.50); line-height: 1.8; max-width: 26rem;"
          >
            If two or three of these ring true, it&rsquo;s time to put the foundations in place
            before the next stage of growth.
          </p>
        </div>

        <div class="fade-up" style="transition-delay: 80ms;">
          <ul class="space-y-0" role="list">
            {[
              'Spend gets approved on trust, not on policy.',
              'Month-end is a scramble and the numbers arrive late.',
              'Too many decisions route through one or two people.',
              'You can’t see, in real time, where the money is going.',
              'A board or investor is asking for rigour you don’t yet have.',
              'Finance is firefighting instead of forecasting.',
            ].map((item) => (
              <li
                class="font-serif py-4 flex items-start gap-4"
                style="font-size: 1.0625rem; color: rgba(255,255,255,0.82); line-height: 1.55; border-bottom: 1px solid rgba(255,255,255,0.08);"
              >
                <span aria-hidden="true" style="color:#00C9BB; flex-shrink:0; margin-top:0.15em;">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8.5l3.5 3.5L14 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4b. FAQ — answer-shaped, drives FAQPage schema
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-white py-24 lg:py-32" aria-label="Common questions">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <p class="page-label mb-12 lg:mb-14 fade-up" style="color:#00C9BB;">Common questions</p>
      <div class="divide-y" style="border-color:#EBEBEB;">
        {faqs.map((f) => (
          <div class="grid lg:grid-cols-12 gap-4 lg:gap-12 py-9 lg:py-11 fade-up">
            <h2 class="lg:col-span-5 font-serif font-bold text-body" style="font-size: clamp(1.2rem, 1.7vw, 1.55rem); letter-spacing: -0.02em; line-height: 1.25;">
              {f.q}
            </h2>
            <p class="lg:col-span-7 font-serif" style="font-size: 1.0625rem; color: rgba(34,34,34,0.72); line-height: 1.8;">
              {f.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       5. CLOSING CTA
  ══════════════════════════════════════════════════════════ -->
  <section
    class="py-24 lg:py-32 relative overflow-hidden"
    aria-label="Contact"
    style="background: #00C9BB;"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 60px 60px;"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 text-center fade-up">
      <h2
        class="font-serif font-bold mb-8 mx-auto"
        style="font-size: clamp(1.75rem, 3.5vw, 3rem); color: #1C1C1E; letter-spacing: -0.025em; line-height: 1.2; max-width: 36rem;"
      >
        Put the foundations in place to scale with confidence.
      </h2>
      <a
        href="/#contact"
        class="font-serif font-bold inline-flex items-center gap-3 px-8 py-4 rounded-sm"
        style="background: #1C1C1E; color: #FFFFFF; font-size: 0.9375rem; letter-spacing: 0.02em; text-decoration: none; box-shadow: 0 4px 16px rgba(28,28,30,0.2); transition: background 0.18s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.18s ease;"
        onmouseover="this.style.background='#2d2d30'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(28,28,30,0.35)'"
        onmouseout="this.style.background='#1C1C1E'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 16px rgba(28,28,30,0.2)'"
      >
        Book a call
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p
        class="font-serif mt-5"
        style="font-size: 0.875rem; color: rgba(28,28,30,0.55);"
      >
        wen@stratumcore.com.au &nbsp;·&nbsp; Brisbane, QLD, Australia
      </p>
    </div>
  </section>

  <Footer />

</BaseLayout>

<style>
  .cta-lg {
    padding: 0.95rem 2.1rem; font-size: 1rem; min-height: 48px;
    display: inline-flex; align-items: center;
  }

  .service-tile { border-top: 2px solid transparent; transition: border-color 0.22s ease; }
  .service-tile:hover { border-top-color: #00C9BB; }

  .tile-number {
    font-family: Georgia, serif; font-size: 0.6875rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: #00C9BB;
  }
</style>

<script>
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
    });
  }, { threshold: 0.07, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
  setTimeout(() => document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible')), 80);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { graph, organization, founder, coPrincipal, breadcrumb } from '../lib/seo';

const schema = graph(
  organization,
  founder,
  coPrincipal,
  breadcrumb([
    { name: 'Home',  url: 'https://www.stratumcore.com.au/' },
    { name: 'About', url: 'https://www.stratumcore.com.au/about' },
  ]),
);
---

<BaseLayout
  title="About StratumCore | Senior Mining Finance Advisory"
  description="StratumCore is led by Wen Khong, a senior finance executive with 20+ years at BHP, Wesfarmers, and BUMA. Independent advisory for the resources sector."
  canonical="https://www.stratumcore.com.au/about"
  ogImageAlt="About StratumCore"
  schema={schema}
>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════
       1. PAGE HERO
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark flex items-end relative overflow-hidden"
    style="min-height: 65vh;"
    aria-label="About StratumCore"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background-image:
          radial-gradient(ellipse 55% 65% at 95% 5%,  rgba(0,201,187,0.06) 0%, transparent 55%),
          radial-gradient(ellipse 40% 50% at 5%  90%, rgba(212,117,26,0.04) 0%, transparent 50%),
          linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
        background-size: auto, auto, 72px 72px, 72px 72px;
      "
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 pb-20 pt-[calc(72px+2.5rem)] w-full">
      <div class="max-w-4xl">

        <p class="page-label mb-6">About StratumCore</p>
        <span class="teal-rule mb-8 block"></span>

        <h1
          class="hero-h1 font-serif font-bold text-white mb-0"
        >
          StratumCore: mining finance advisory built by someone who's done the&nbsp;job.
        </h1>

        <p
          class="font-sans mt-6 leading-relaxed"
          style="font-size: clamp(0.9375rem, 1.3vw, 1.125rem); color: var(--on-dark-2); max-width: 38rem; line-height: 1.75;"
        >
          StratumCore is an independent advisory partnership. No junior consultants.
          No templated solutions.
        </p>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. WEN'S BIO
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light border-b" style="border-color: var(--hairline);" aria-label="Wen Khong">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-20 items-start">

        <!-- Photo — narrower left col -->
        <div class="lg:col-span-2 fade-up">
          <figure class="portrait">
            <picture>
              <source type="image/webp" sizes="(min-width: 1024px) 360px, 100vw"
                      srcset="/images/portrait-wen-560.webp 560w, /images/portrait-wen-840.webp 840w" />
              <img
                src="/images/portrait-wen-560.jpg"
                srcset="/images/portrait-wen-560.jpg 560w, /images/portrait-wen-840.jpg 840w"
                sizes="(min-width: 1024px) 360px, 100vw"
                width="560" height="700"
                alt="Wen Khong, Principal at StratumCore"
                loading="eager"
                decoding="async"
              />
            </picture>
          </figure>
        </div>

        <!-- Bio text — wider right col -->
        <div class="lg:col-span-3 fade-up">

          <p
            class="font-sans font-bold mb-2"
            style="font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);"
          >
            Principal | StratumCore
          </p>

          <h2
            class="font-serif font-bold text-body mb-8"
            style="font-size: clamp(1.75rem, 2.8vw, 2.5rem); letter-spacing: -0.025em; line-height: 1.1;"
          >
            Wen Khong
          </h2>

          <div
            class="font-sans leading-relaxed space-y-5"
            style="font-size: 1rem; color: var(--body); line-height: 1.85; max-width: 34rem;"
          >
            <p>
              Wen is a finance and transformation leader with experience supporting
              large asset-intensive organisations across mining and industrial sectors.
              He has delivered initiatives focused on finance capability improvement,
              operational performance, and financial governance — helping leadership
              teams strengthen financial insight and decision support.
            </p>
            <p>
              Having spent time on the other side of the fence as a Production Coal
              Manager, his work focuses on improving how finance teams partner better
              with operational leaders and support more disciplined operational and
              capital decision-making.
            </p>
            <p>
              Wen is a Chartered Accountant (CA ANZ) and Chartered Secretary (AGIA),
              holds a Bachelor of Commerce in Professional Accounting and Finance, and
              is a Harvard Business School alumnus.
            </p>
            <p>
              He founded StratumCore to give mid-market businesses direct access to
              that depth of experience, without the overhead of a large firm.
            </p>
          </div>

          <!-- Credential badges -->
          <div class="mt-10 flex flex-wrap gap-2">
            {['BHP', 'Wesfarmers', 'BUMA', 'Ernst & Young'].map((org) => (
              <span
                class="font-sans font-bold"
                style="font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: var(--bg-alt); border: 1px solid var(--hairline); padding: 0.3rem 0.75rem; border-radius: 2px;"
              >
                {org}
              </span>
            ))}
          </div>

        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. CALVIN'S BIO
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="Calvin">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-20 items-start">

        <!-- Photo placeholder — narrower left col -->
        <div class="lg:col-span-2 fade-up">
          <figure class="portrait">
            <picture>
              <source type="image/webp" sizes="(min-width: 1024px) 360px, 100vw"
                      srcset="/images/portrait-calvin-560.webp 560w, /images/portrait-calvin-840.webp 840w" />
              <img
                src="/images/portrait-calvin-560.jpg"
                srcset="/images/portrait-calvin-560.jpg 560w, /images/portrait-calvin-840.jpg 840w"
                sizes="(min-width: 1024px) 360px, 100vw"
                width="560" height="700"
                alt="Calvin Yong, Principal at StratumCore"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>
        </div>

        <!-- Bio text — wider right col -->
        <div class="lg:col-span-3 fade-up">

          <p
            class="font-sans font-bold mb-2"
            style="font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);"
          >
            Principal | StratumCore
          </p>

          <h2
            class="font-serif font-bold text-body mb-8"
            style="font-size: clamp(1.75rem, 2.8vw, 2.5rem); letter-spacing: -0.025em; line-height: 1.1;"
          >
            Calvin Yong
          </h2>

          <div
            class="font-sans leading-relaxed space-y-5"
            style="font-size: 1rem; color: var(--body); line-height: 1.85; max-width: 34rem;"
          >
            <p>
              Calvin has extensive experience across commercial strategy, operational
              performance, and major contract negotiations within large mining and
              industrial organisations.
            </p>
            <p>
              He has worked closely with operational and executive leadership teams
              to improve cost performance, operational effectiveness, and commercial
              outcomes — and has supported major supplier negotiations and capital
              investment decisions. Calvin's approach is grounded in delivery,
              ensuring initiatives are not only well-defined but executed effectively
              to achieve measurable results. He is known for clear, structured
              thinking that cuts through complexity and challenges assumptions.
            </p>
            <p>
              Calvin holds an MBA from The University of Queensland, is a Certified
              Practising Accountant (CPA), and holds a Bachelor of Commerce in
              Accounting and Finance.
            </p>
          </div>

          <!-- Credential badges -->
          <div class="mt-10 flex flex-wrap gap-2">
            {['BMA', 'BHP', 'Bankwest', 'CS Gas'].map((org) => (
              <span
                class="font-sans font-bold"
                style="font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: var(--bg-alt); border: 1px solid var(--hairline); padding: 0.3rem 0.75rem; border-radius: 2px;"
              >
                {org}
              </span>
            ))}
          </div>

        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. WHY STRATUMCORE — Stone bg, three-column
  ══════════════════════════════════════════════════════════ -->
  <section class="py-24 lg:py-32" style="background: var(--bg-alt);" aria-label="Our philosophy">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="mb-16 fade-up">
        <p class="page-label mb-4">Our philosophy</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 28rem;"
        >
          What makes us different.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px" style="background: var(--hairline);">

        <article class="diff-card section-alt p-8 lg:p-10 fade-up">
          <div class="mb-5" style="width: 2.5rem; height: 2px; background: var(--accent); border-radius: 1px;"></div>
          <h3 class="font-serif font-bold text-body mb-3" style="font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.2;">
            Senior from day one
          </h3>
          <p class="font-sans leading-relaxed" style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;">
            You get Wen, not a graduate with a framework.
          </p>
        </article>

        <article class="diff-card section-alt p-8 lg:p-10 fade-up">
          <div class="mb-5" style="width: 2.5rem; height: 2px; background: var(--accent); border-radius: 1px;"></div>
          <h3 class="font-serif font-bold text-body mb-3" style="font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.2;">
            Independent
          </h3>
          <p class="font-sans leading-relaxed" style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;">
            No conflicts, no product to sell, no firm politics.
          </p>
        </article>

        <article class="diff-card section-alt p-8 lg:p-10 fade-up">
          <div class="mb-5" style="width: 2.5rem; height: 2px; background: var(--accent); border-radius: 1px;"></div>
          <h3 class="font-serif font-bold text-body mb-3" style="font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.2;">
            Sector-specific
          </h3>
          <p class="font-sans leading-relaxed" style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;">
            We know mining finance. We don't need a learning curve at your expense.
          </p>
        </article>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       5. PARTNERSHIPS — White, prose
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="How we work">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <div class="fade-up">
          <p class="page-label mb-4" style="color: var(--accent);">How we work</p>
          <h2
            class="font-serif font-bold text-body"
            style="font-size: clamp(1.75rem, 2.8vw, 2.5rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 22rem;"
          >
            Principal-led. Always.
          </h2>
        </div>

        <div class="fade-up">
          <p
            class="font-sans leading-relaxed mb-6"
            style="font-size: 1rem; color: var(--body); line-height: 1.85; max-width: 34rem;"
          >
            StratumCore operates as a principal-led advisory partnership. For
            engagements that require broader capability, we draw on a trusted
            network of senior independent specialists — all with mining or resources
            backgrounds.
          </p>
          <p
            class="font-sans"
            style="font-size: 0.875rem; color: var(--muted); line-height: 1.7;"
          >
            StratumCore is the trading entity of StratumCore Pty Ltd.
            ABN: 61 696 477 406.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       6. CLOSING CTA
  ══════════════════════════════════════════════════════════ -->
  <section
    class="section-alt relative"
    aria-label="Contact"
  >

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 text-center fade-up">
      <h2
        class="font-serif font-bold mb-3 mx-auto"
        style="font-size: clamp(2rem, 4vw, 3.5rem); color: var(--ink); letter-spacing: -0.03em; line-height: 1.1;"
      >
        Let's talk.
      </h2>
      <p
        class="font-sans mb-8 mx-auto"
        style="font-size: 1.0625rem; color: var(--body); max-width: 28rem; line-height: 1.7;"
      >
        Discovery calls are free, focused, and no obligation.
      </p>
      <a
        href="/#contact"
        class="font-sans font-bold inline-flex items-center gap-3 px-8 py-4 rounded-sm"
        style="background: var(--accent); color: var(--accent-fg); font-size: 0.9375rem; letter-spacing: 0.02em; text-decoration: none; transition: background 0.18s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1);"
        onmouseover="this.style.background=\'var(--accent-strong)\'; this.style.transform=\'translateY(-2px)\'"
        onmouseout="this.style.background=\'var(--accent)\'; this.style.transform=\'translateY(0)\'"
      >
        Book a call
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p
        class="font-sans mt-5"
        style="font-size: 0.875rem; color: var(--muted);"
      >
        wen@stratumcore.com.au &nbsp;·&nbsp; Brisbane, QLD, Australia
      </p>
    </div>
  </section>

  <Footer />

</BaseLayout>

<style>
  .diff-card {
    border-top: 2px solid transparent;
    transition: border-color 0.22s ease;
  }
  .diff-card:hover {
    border-top-color: var(--accent);
  }
</style>

<script>
  // Scroll reveal. Grouped siblings stagger off --i so cards arrive in
  // sequence rather than together. The hero carries no .fade-up at all, so it
  // paints at full opacity on first frame.
  const reveal = () => {
    const items = [...document.querySelectorAll('.fade-up')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('visible'));
      return;
    }
    items.forEach(el => {
      const sibs = [...(el.parentElement?.children ?? [])].filter(n => n.classList.contains('fade-up'));
      if (sibs.length > 1) el.style.setProperty('--i', String(sibs.indexOf(el)));
    });

    // Anything already on screen at load is shown immediately, with no
    // transition, so the first viewport is never caught mid-fade.
    const vh = window.innerHeight;
    items.forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) { el.style.setProperty('--i', '0'); el.classList.add('instant', 'visible'); }
    });

    // rootMargin fires the reveal a screen-worth early, so an element is
    // already at full opacity by the time it is actually scrolled into view.
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        // If it is already well inside the viewport, a fast scroll outran the
        // observer — skip the transition rather than fade it in late.
        const r = e.target.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.75) e.target.classList.add('instant');
        e.target.classList.add('visible');
        io.unobserve(e.target);
      });
    }, { threshold: 0, rootMargin: '0px 0px 45% 0px' });
    items.forEach(el => { if (!el.classList.contains('visible')) io.observe(el); });
  };
  reveal();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { graph, organization, founder, service, faqPage, breadcrumb, ORG_ID } from '../lib/seo';

const modules = [
  {
    n: '01',
    title: 'Financial Storytelling',
    body: 'Turn data into narrative. Learn to communicate financial insights in a way that lands with operational and executive audiences.',
  },
  {
    n: '02',
    title: 'Influencing Without Authority',
    body: 'Build the stakeholder skills to drive decisions even when you don\'t hold the budget.',
  },
  {
    n: '03',
    title: 'Value Driver Trees',
    body: 'Map what actually moves the business — and connect finance activity directly to value creation.',
  },
  {
    n: '04',
    title: 'Diagnostic Problem Solving',
    body: 'Apply structured problem-solving to commercial and operational challenges, not just financial ones.',
  },
  {
    n: '05',
    title: 'Planning & Execution',
    body: 'Design planning processes that reflect operational reality, not just accounting periods.',
  },
];
const faqs = [
  {
    q: 'How do I train my finance team to become finance business partners?',
    a: 'The Finance Business Partner Academy is a structured five-module programme that closes the gap between technical accounting competence and genuine business partnering. It covers financial storytelling, influencing without authority, value driver trees, diagnostic problem solving, and planning and execution. It is built for finance teams in any industry.',
  },
  {
    q: 'What does the FBP Academy cover?',
    a: 'Five sequenced modules, each ending with a tool or framework your team can use immediately. Modules use a real-world, case-study method so theory is grounded in decisions made under pressure rather than abstract textbook cases.',
  },
  {
    q: 'How is the Academy delivered?',
    a: 'As an in-house cohort for your team, an open mixed-company cohort, or as individual modules run as standalone workshops. It is designed to fit around how finance teams actually work.',
  },
  {
    q: 'Who is the FBP Academy for?',
    a: 'Finance managers stepping into business partner roles, CFOs building team capability, and finance teams in any industry or sector who want to move beyond reporting into genuine commercial influence.',
  },
];

const course = {
  '@type': 'Course',
  name: 'Finance Business Partner Academy',
  description: 'A five-module programme for finance professionals in any industry. Covers financial storytelling, influencing, value driver trees, diagnostic problem solving, and planning.',
  provider: { '@id': ORG_ID },
  educationalLevel: 'Professional development',
  url: 'https://www.stratumcore.com.au/finance-business-partner-academy',
};

const schema = graph(
  organization,
  founder,
  course,
  service({
    id: 'https://www.stratumcore.com.au/finance-business-partner-academy/#service',
    name: 'Finance Business Partner Training',
    serviceType: 'Finance business partnering',
    description: 'A five-module programme that turns finance teams into genuine business partners — storytelling, influence, value drivers, problem solving and planning.',
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home',                            url: 'https://www.stratumcore.com.au/' },
    { name: 'Finance Team Building',           url: 'https://www.stratumcore.com.au/finance-team-building' },
    { name: 'Finance Business Partner Academy', url: 'https://www.stratumcore.com.au/finance-business-partner-academy' },
  ]),
);
---

<BaseLayout
  title="Finance Business Partner Academy | StratumCore"
  description="A five-module FBP programme built for finance teams in any industry. Financial storytelling, influencing, value drivers, and commercial problem solving."
  canonical="https://www.stratumcore.com.au/finance-business-partner-academy"
  ogImage="https://www.stratumcore.com.au/og-image-training.png"
  ogImageAlt="Finance Business Partner Academy — StratumCore"
  schema={schema}
>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════
       1. PAGE HERO
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark flex items-end relative overflow-hidden"
    style="min-height: 65vh;"
    aria-label="Finance Business Partner Academy"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background-image:
          radial-gradient(ellipse 60% 65% at 95% 5%,  rgba(0,201,187,0.07) 0%, transparent 55%),
          radial-gradient(ellipse 40% 45% at 0%  90%, rgba(212,117,26,0.04) 0%, transparent 50%),
          linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
        background-size: auto, auto, 72px 72px, 72px 72px;
      "
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 pb-20 pt-[calc(72px+2.5rem)] w-full">
      <div class="max-w-4xl">

        <p class="page-label mb-6">Finance Business Partner Academy</p>
        <span class="teal-rule mb-8 block"></span>

        <h1
          class="hero-h1 font-serif font-bold text-white mb-0"
        >
          Finance Business Partner&nbsp;Academy.
        </h1>

        <p
          class="font-sans font-bold mt-8"
          style="font-size: clamp(1rem, 1.6vw, 1.25rem); color: rgba(255,255,255,0.94); letter-spacing: -0.01em;"
        >
          Five modules. One clear outcome: finance that drives decisions.
        </p>

        <p
          class="font-sans mt-4 leading-relaxed"
          style="font-size: clamp(0.9375rem, 1.2vw, 1.0625rem); color: var(--on-dark-2); max-width: 40rem; line-height: 1.75;"
        >
          A structured programme for finance professionals in any industry who
          want to move beyond reporting and into genuine commercial influence.
        </p>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. THE PROGRAMME — Module cards
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="The curriculum">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="mb-16 fade-up">
        <p class="page-label mb-4" style="color: var(--accent);">The curriculum</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 28rem;"
        >
          What you'll work through.
        </h2>
      </div>

      <!-- Module list — alternating layout with connecting line on desktop -->
      <div class="relative">

        <!-- Vertical progress line (desktop only) -->
        <div
          class="absolute left-[1.6rem] top-0 bottom-0 w-px hidden lg:block"
          style="background: linear-gradient(to bottom, var(--accent) 0%, rgba(0,201,187,0.15) 100%);"
          aria-hidden="true"
        ></div>

        <div class="space-y-0 divide-y" style="border-color: var(--hairline);">
          {modules.map((mod, i) => (
            <article
              class="module-row group grid lg:grid-cols-[auto_1fr] gap-8 lg:gap-16 py-10 fade-up"
            >
              <!-- Module number + dot on timeline -->
              <div class="flex items-start gap-6 lg:gap-0 lg:flex-col lg:items-center" style="min-width: 3.5rem;">
                <div
                  class="module-dot flex-shrink-0 flex items-center justify-center font-sans font-bold"
                  style="width: 3.25rem; height: 3.25rem; border-radius: 50%; background: rgba(0,201,187,0.10); border: 1.5px solid rgba(0,201,187,0.30); font-size: 0.6875rem; letter-spacing: 0.12em; color: var(--accent); transition: background 0.22s ease, border-color 0.22s ease;"
                >
                  {mod.n}
                </div>
              </div>

              <!-- Content -->
              <div class="pt-1">
                <h3
                  class="font-serif font-bold text-body mb-3"
                  style="font-size: clamp(1.2rem, 1.8vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.2;"
                >
                  {mod.title}
                </h3>
                <p
                  class="font-sans leading-relaxed"
                  style="font-size: 0.9375rem; color: var(--body); line-height: 1.75; max-width: 46rem;"
                >
                  {mod.body}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. HOW IT'S DIFFERENT — Stone bg, three differentiator cards
  ══════════════════════════════════════════════════════════ -->
  <section class="py-24 lg:py-32" style="background: var(--bg-alt);" aria-label="Why this works">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="mb-16 fade-up">
        <p class="page-label mb-4">Why this works</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 30rem;"
        >
          Taught the way finance leaders actually learn.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px" style="background: var(--hairline);">

        <!-- Differentiator 1 -->
        <article class="diff-card section-alt p-8 lg:p-10 flex flex-col fade-up">
          <div class="mb-6" style="width: 2.5rem; height: 2px; background: var(--accent); border-radius: 1px;"></div>
          <h3
            class="font-serif font-bold text-body mb-4"
            style="font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.2;"
          >
            HBS case study method
          </h3>
          <p
            class="font-sans leading-relaxed"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;"
          >
            Each module uses real business cases (HBS-style) to ground theory in
            decision-making under pressure.
          </p>
        </article>

        <!-- Differentiator 2 -->
        <article class="diff-card section-alt p-8 lg:p-10 flex flex-col fade-up">
          <div class="mb-6" style="width: 2.5rem; height: 2px; background: var(--accent); border-radius: 1px;"></div>
          <h3
            class="font-serif font-bold text-body mb-4"
            style="font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.2;"
          >
            Real-world context
          </h3>
          <p
            class="font-sans leading-relaxed"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;"
          >
            Scenarios and language drawn from real operations and commercial
            decisions, not abstract textbook cases.
          </p>
        </article>

        <!-- Differentiator 3 -->
        <article class="diff-card section-alt p-8 lg:p-10 flex flex-col fade-up">
          <div class="mb-6" style="width: 2.5rem; height: 2px; background: var(--accent); border-radius: 1px;"></div>
          <h3
            class="font-serif font-bold text-body mb-4"
            style="font-size: 1.125rem; letter-spacing: -0.02em; line-height: 1.2;"
          >
            Applied, not academic
          </h3>
          <p
            class="font-sans leading-relaxed"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;"
          >
            Every module ends with a tool or framework your team can use immediately
            back in the business.
          </p>
        </article>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. WHO IT'S FOR — White, two-column
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="Who it's for">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <div class="mb-16 fade-up">
        <p class="page-label mb-4" style="color: var(--accent);">Participation</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; max-width: 26rem;"
        >
          Who it's for and how it's run.
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-0 lg:gap-px" style="background: var(--hairline);">

        <!-- Left: Ideal for -->
        <div class="section-light p-8 lg:p-12 fade-up">
          <p
            class="font-sans font-bold mb-8"
            style="font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);"
          >
            Ideal for
          </p>
          <ul class="space-y-0" role="list">
            {[
              'Finance managers stepping into business partner roles',
              'CFOs building team capability',
              'Finance teams in any industry or sector',
            ].map((item) => (
              <li
                class="who-bullet font-sans py-5"
                style="font-size: 1rem; color: var(--body); line-height: 1.55; border-bottom: 1px solid var(--hairline); display: flex; align-items: flex-start; gap: 0.875rem;"
              >
                <span style="display: inline-block; flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); margin-top: 0.55em;" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Delivered as -->
        <div class="section-light p-8 lg:p-12 fade-up">
          <p
            class="font-sans font-bold mb-8"
            style="font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);"
          >
            Delivered as
          </p>
          <ul class="space-y-0" role="list">
            {[
              'In-house cohort (your team, your site, your schedule)',
              'Open cohort (mixed-company intake — contact us for dates)',
              'Modular — individual modules available as standalone workshops',
            ].map((item) => (
              <li
                class="who-bullet font-sans py-5"
                style="font-size: 1rem; color: var(--body); line-height: 1.55; border-bottom: 1px solid var(--hairline); display: flex; align-items: flex-start; gap: 0.875rem;"
              >
                <span style="display: inline-block; flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); margin-top: 0.55em;" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4b. FAQ — answer-shaped, drives FAQPage schema
  ══════════════════════════════════════════════════════════ -->
  <section class="py-24 lg:py-32" style="background: var(--bg-alt);" aria-label="Common questions">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <p class="page-label mb-12 lg:mb-14 fade-up" style="color:var(--accent);">Common questions</p>
      <div class="divide-y" style="border-color:var(--hairline);">
        {faqs.map((f) => (
          <div class="grid lg:grid-cols-12 gap-4 lg:gap-12 py-9 lg:py-11 fade-up">
            <h2 class="lg:col-span-5 font-serif font-bold text-body" style="font-size: clamp(1.2rem, 1.7vw, 1.55rem); letter-spacing: -0.02em; line-height: 1.25;">
              {f.q}
            </h2>
            <p class="lg:col-span-7 font-sans" style="font-size: 1.0625rem; color: var(--body); line-height: 1.8;">
              {f.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       5. CLOSING CTA
  ══════════════════════════════════════════════════════════ -->
  <section
    class="section-alt relative"
    aria-label="Contact"
  >

    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 text-center fade-up">
      <h2
        class="font-serif font-bold mb-8 mx-auto"
        style="font-size: clamp(1.75rem, 3.5vw, 3rem); color: var(--ink); letter-spacing: -0.025em; line-height: 1.2; max-width: 38rem;"
      >
        Interested in running the Academy with your team?
      </h2>
      <a
        href="/#contact"
        class="font-sans font-bold inline-flex items-center gap-3 px-8 py-4 rounded-sm"
        style="background: var(--accent); color: var(--accent-fg); font-size: 0.9375rem; letter-spacing: 0.02em; text-decoration: none; transition: background 0.18s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1);"
        onmouseover="this.style.background=\'var(--accent-strong)\'; this.style.transform=\'translateY(-2px)\'"
        onmouseout="this.style.background=\'var(--accent)\'; this.style.transform=\'translateY(0)\'"
      >
        Get in touch
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p
        class="font-sans mt-5"
        style="font-size: 0.875rem; color: var(--muted);"
      >
        wen@stratumcore.com.au &nbsp;·&nbsp; Brisbane, QLD, Australia
      </p>
    </div>
  </section>

  <Footer />

</BaseLayout>

<style>
  .module-row:hover .module-dot {
    background: rgba(0,201,187,0.20);
    border-color: var(--accent);
  }

  .diff-card {
    border-top: 2px solid transparent;
    transition: border-color 0.22s ease;
  }
  .diff-card:hover {
    border-top-color: var(--accent);
  }
</style>

<script>
  // Scroll reveal. Grouped siblings stagger off --i so cards arrive in
  // sequence rather than together. The hero carries no .fade-up at all, so it
  // paints at full opacity on first frame.
  const reveal = () => {
    const items = [...document.querySelectorAll('.fade-up')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('visible'));
      return;
    }
    items.forEach(el => {
      const sibs = [...(el.parentElement?.children ?? [])].filter(n => n.classList.contains('fade-up'));
      if (sibs.length > 1) el.style.setProperty('--i', String(sibs.indexOf(el)));
    });

    // Anything already on screen at load is shown immediately, with no
    // transition, so the first viewport is never caught mid-fade.
    const vh = window.innerHeight;
    items.forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) { el.style.setProperty('--i', '0'); el.classList.add('instant', 'visible'); }
    });

    // rootMargin fires the reveal a screen-worth early, so an element is
    // already at full opacity by the time it is actually scrolled into view.
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        // If it is already well inside the viewport, a fast scroll outran the
        // observer — skip the transition rather than fade it in late.
        const r = e.target.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.75) e.target.classList.add('instant');
        e.target.classList.add('visible');
        io.unobserve(e.target);
      });
    }, { threshold: 0, rootMargin: '0px 0px 45% 0px' });
    items.forEach(el => { if (!el.classList.contains('visible')) io.observe(el); });
  };
  reveal();
</script>

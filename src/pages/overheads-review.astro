---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="The overheads review — StratumCore"
  description="A two-page case study on overhead roles: how a mid-sized Australian miner found 15–20% savings in its overhead structure, without a single top-down cut."
  canonical="https://www.stratumcore.com.au/overheads-review"
  noindex={true}
>
  <!-- No top navigation: this is a single-purpose capture page reached from a
       printed QR code. The co-brand lockup stands in for the nav — equal
       weight to both marks, separated by a hairline. -->
  <header class="wedge-head">
    <div class="cobrand">
      <a href="/" class="wordmark" aria-label="StratumCore home">
        <span class="part-stratum">Stratum</span><span class="part-core">Core</span>
      </a>
      <span class="cobrand__x" aria-hidden="true">&#215;</span>
      <img
        src="/brand_assets/joblin-partners-dark-bg.png"
        alt="Joblin Partners"
        class="cobrand__joblin"
        width="282" height="110" decoding="async"
      />
    </div>
  </header>

  <main>
    <!-- ─── Dark wedge ─────────────────────────────────────────── -->
    <section class="wedge hero-dark" aria-labelledby="review-h1">
      <div class="wedge-inner">
        <h1 id="review-h1">The overheads review</h1>

        <span class="teal-rule" aria-hidden="true"></span>

        <p class="lead">
          A case study on overhead roles &mdash; how a mid-sized Australian miner
          found 15&ndash;20% savings in its overhead structure, without a single
          top-down cut. Two pages, method and all.
        </p>
      </div>
    </section>

    <!-- ─── Form card, overlapping the wedge ───────────────────── -->
    <section class="card-zone" aria-label="Get the case study">
      <div class="card">

        <form id="review-form" novalidate>
          <!-- Honeypot (spam trap) -->
          <input type="text" name="botcheck" class="hp-field" tabindex="-1"
                 autocomplete="off" aria-hidden="true" />

          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email"
                   inputmode="email" enterkeyhint="send" required aria-required="true" />
            <p class="err" data-err-for="f-email" hidden>Please enter a valid email address.</p>
          </div>

          <button type="submit" class="submit" id="submit-btn">
            <span class="submit__label">Email it to me</span>
            <svg class="submit__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.6"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <p class="consent">
            One email, one file. No newsletter &mdash; the email that delivers this
            file is the only automated email you&rsquo;ll ever get from us.
          </p>

          <p class="status" id="form-error" role="alert" hidden></p>
        </form>

        <!-- Success state — same page, no redirect -->
        <div class="success" id="form-success" hidden role="status" tabindex="-1">
          <div class="success__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 16 16" fill="none">
              <path d="M2 8.5l3.5 3.5L14 4" stroke="currentColor" stroke-width="1.8"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 class="success__h">Done &mdash; check your inbox.</h2>
          <p class="success__b">One email, one file.</p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ─── Wedge head ───────────────────────────────────────────── */
  .wedge-head {
    background: var(--ink);
    padding: 1.25rem 1.25rem 0;
  }
  @media (min-width: 640px) { .wedge-head { padding: 1.75rem 2rem 0; } }

  /* ─── Co-brand lockup ──────────────────────────────────────── */
  .cobrand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  /* Hairline separator. Sized down and dimmed so neither mark reads as
     subordinate to the other — the divider should recede, not compete. */
  .cobrand__x {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.28);
    flex-shrink: 0;
  }

  /* Joblin's mark stacks two words, so matching the single-line wordmark by
     bounding-box height would leave it looking undersized. Sized up until the
     two logos carry equal optical weight. */
  .cobrand__joblin {
    height: 34px;
    width: auto;
    display: block;
    flex-shrink: 0;
    /* Optical correction: the mark opens on a thin curved stroke, so an equal
       measured gap reads as a wider one. Pull it back by 2px. */
    margin-left: -2px;
  }
  @media (min-width: 640px) {
    .cobrand { gap: 1rem; }
    .cobrand__joblin { height: 40px; }
    .cobrand__x { font-size: 1rem; }
  }

  /* ─── Dark wedge ───────────────────────────────────────────── */
  .wedge {
    background: var(--ink);
    /* Angled bottom edge — the wedge. Extra padding covers the cut. */
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 3.25rem), 0 100%);
    padding: 2rem 1.25rem 5.5rem;
  }
  @media (min-width: 640px) {
    .wedge {
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 4rem), 0 100%);
      padding: 3rem 2rem 7rem;
    }
  }

  .wedge-inner { max-width: 44rem; margin: 0 auto; }

  h1 {
    font-family: var(--font-body);
    font-weight: 700;
    color: #FFFFFF;
    font-size: clamp(2rem, 8vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .lead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    margin-top: 1.5rem;
    max-width: 34rem;
    text-wrap: pretty;
  }

  /* ─── Card zone ────────────────────────────────────────────── */
  .card-zone {
    background: var(--bg-alt);
    padding: 0 1.25rem 3.5rem;
  }
  @media (min-width: 640px) { .card-zone { padding: 0 2rem 5rem; } }

  .card {
    max-width: 34rem;
    margin: -3rem auto 0; /* lifts the card up into the wedge */
    position: relative;
    z-index: 2;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--accent);
    border-radius: 8px;
    padding: 1.5rem 1.25rem 1.25rem;
    box-shadow: 0 1px 2px var(--muted),
                0 18px 40px -16px var(--muted);
  }
  @media (min-width: 640px) { .card { margin-top: -4rem; padding: 2rem; } }

  /* ─── Field ────────────────────────────────────────────────── */
  .field  { display: flex; flex-direction: column; }

  .field label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  .field input {
    font-family: var(--font-body);
    /* 16px minimum stops iOS Safari zooming the page on focus */
    font-size: 1rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 5px;
    padding: 0.72rem 0.85rem;
    min-height: 48px;
    width: 100%;
    transition: border-color var(--dur-mid) var(--ease), background var(--dur-mid) var(--ease), box-shadow var(--dur-mid) var(--ease);
  }
  .field input:hover { border-color: var(--muted); }
  .field input:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0,201,187,0.16);
  }
  .field input[aria-invalid="true"] {
    border-color: #C0392B;
    box-shadow: 0 0 0 3px rgba(192,57,43,0.12);
  }
  .field .err {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: #C0392B;
    margin-top: 0.35rem;
  }

  /* Honeypot — visually hidden, off-screen */
  .hp-field {
    position: absolute; left: -9999px;
    width: 1px; height: 1px; opacity: 0;
  }

  /* ─── Submit ───────────────────────────────────────────────── */
  .submit {
    margin-top: 1.25rem;
    width: 100%;
    min-height: 54px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--accent-fg);
    background: var(--accent-fill);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 4px 14px var(--muted);
    transition: background 0.18s ease,
                transform 0.18s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.18s ease;
  }
  .submit:hover {
    background: var(--accent-strong);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px var(--muted);
  }
  .submit:active { transform: translateY(0); }
  .submit:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .submit[disabled] { opacity: 0.6; cursor: progress; transform: none; }
  .submit__arrow { transition: transform 0.2s ease; }
  .submit:hover .submit__arrow { transform: translateX(3px); }

  .consent {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
    text-align: center;
    margin-top: 0.95rem;
  }

  .status {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: #C0392B;
    text-align: center;
    margin-top: 1rem;
  }

  /* ─── Success ──────────────────────────────────────────────── */
  .success { text-align: center; padding: 1.75rem 0.5rem 1.25rem; }
  .success:focus { outline: none; }
  .success__icon {
    width: 54px; height: 54px;
    margin: 0 auto 1.1rem;
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    background: rgba(0,201,187,0.12);
    border-radius: 50%;
  }
  .success__h {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .success__b {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--body);
  }

  @media (prefers-reduced-motion: reduce) {
    .submit, .submit__arrow { transition: none; }
    .submit:hover { transform: none; }
  }
</style>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;

  if (form) {
    const emailEl   = document.getElementById('f-email')      as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn')   as HTMLButtonElement;
    const errBox    = document.getElementById('form-error')   as HTMLParagraphElement;
    const successEl = document.getElementById('form-success') as HTMLDivElement;
    const labelEl   = submitBtn.querySelector('.submit__label') as HTMLSpanElement;

    // The printed QR codes carry utm_source / utm_medium / utm_campaign. Read
    // them here and hand them to the server, which writes them as custom fields
    // and defaults any that are missing to "direct".
    const params = new URLSearchParams(window.location.search);
    const utm = {
      utm_source:   params.get('utm_source')   || 'direct',
      utm_medium:   params.get('utm_medium')   || 'direct',
      utm_campaign: params.get('utm_campaign') || 'direct',
    };

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showFieldError = (el: HTMLInputElement, show: boolean) => {
      el.setAttribute('aria-invalid', String(show));
      const msg = document.querySelector(`[data-err-for="${el.id}"]`) as HTMLElement | null;
      if (msg) msg.hidden = !show;
    };

    // Clear the error as soon as the visitor starts correcting it
    emailEl.addEventListener('input', () => {
      if (emailEl.getAttribute('aria-invalid') === 'true') showFieldError(emailEl, false);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.hidden = true;

      if (!emailRe.test(emailEl.value.trim())) {
        showFieldError(emailEl, true);
        emailEl.focus();
        return;
      }

      submitBtn.disabled = true;
      const original = labelEl.textContent;
      labelEl.textContent = 'Sending…';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email:    emailEl.value.trim(),
            botcheck: (form.elements.namedItem('botcheck') as HTMLInputElement).value,
            ...utm,
          }),
        });
        const json = await res.json().catch(() => ({}));

        if (!res.ok || !json.success) throw new Error(json.message || 'Submission failed');

        (window as any).gtag?.('event', 'overheads_review_signup', {
          event_category: 'conversion',
          utm_source:   utm.utm_source,
          utm_medium:   utm.utm_medium,
          utm_campaign: utm.utm_campaign,
        });

        form.hidden = true;
        successEl.hidden = false;
        successEl.focus();
      } catch (err) {
        errBox.textContent =
          (err as Error).message ||
          'Something went wrong. Please email wen@stratumcore.com.au and we’ll send it over.';
        errBox.hidden = false;
        submitBtn.disabled = false;
        labelEl.textContent = original;
      }
    });
  }
</script>

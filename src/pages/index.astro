---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { graph, organization, founder, coPrincipal, breadcrumb } from '../lib/seo';

const schema = graph(
  organization,
  founder,
  coPrincipal,
  breadcrumb([
    { name: 'Home', url: 'https://www.stratumcore.com.au/' },
  ]),
);

// Web3Forms access key (same key used in the redesign contact form)
const WEB3FORMS_ACCESS_KEY = "8274a80a-9baa-44f7-978c-3226595639e5";
---

<BaseLayout
  title="Mining Finance & Cost Reduction Advisory | StratumCore"
  description="StratumCore delivers senior, independent advisory for mining and asset-intensive businesses — cost reduction, financial control and governance, and finance team building. No juniors."
  canonical="https://www.stratumcore.com.au/"
  ogImage="https://www.stratumcore.com.au/og-image-home.png"
  ogImageAlt="StratumCore — Finance & Leadership Consulting, Brisbane"
  schema={schema}
>

  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/images/hero-open-cut-graded-1536.webp"
      imagesrcset="/images/hero-open-cut-graded-640.webp 640w, /images/hero-open-cut-graded-1024.webp 1024w, /images/hero-open-cut-graded-1536.webp 1536w"
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════
       1. HERO — full-bleed photograph
       The colour grade is baked into the image assets by grade-images.mjs;
       there is no runtime filter on this photograph.
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark hero-photo min-h-screen flex flex-col justify-end relative overflow-hidden"
    aria-label="Hero"
  >
    <picture class="hero-photo__media">
      <source
        type="image/webp"
        sizes="100vw"
        srcset="/images/hero-open-cut-graded-640.webp 640w, /images/hero-open-cut-graded-1024.webp 1024w, /images/hero-open-cut-graded-1536.webp 1536w"
      />
      <img
        class="hero-photo__img"
        src="/images/hero-open-cut-graded-1536.jpg"
        srcset="/images/hero-open-cut-graded-640.jpg 640w, /images/hero-open-cut-graded-1024.jpg 1024w, /images/hero-open-cut-graded-1536.jpg 1536w"
        sizes="100vw"
        width="1536"
        height="1024"
        fetchpriority="high"
        decoding="async"
        alt="Two mine workers in orange hi-vis and hard hats stand at the edge of an open-cut coal pit, one pointing across the exposed strata of the pit wall."
      />
    </picture>

    <div class="hero-photo__scrim" aria-hidden="true"></div>

    <div class="hero-photo__content relative max-w-site mx-auto px-6 lg:px-10 w-full pb-20 pt-[72px]">
      <div class="max-w-4xl">

        <p class="page-label mb-5">Independent advisory &nbsp;·&nbsp; Mining &amp; resource sector</p>
        <span class="teal-rule mb-10 block"></span>

        <!-- Main headline -->
        <h1
          class="hero-h1 hero-h1--home font-serif font-bold text-white mb-0"
        >
          Independent finance advisory for the mining&nbsp;sector.
        </h1>

        <!-- Sub-line — headline-scale type, so white, not accent -->
        <p
          class="font-sans font-bold mt-8"
          style="font-size: clamp(1rem, 1.8vw, 1.375rem); color: rgba(255,255,255,0.94); letter-spacing: -0.01em; max-width: 34rem;"
        >
          We help resource operators reduce cost, strengthen performance and build finance capability.
        </p>

        <!-- Supporting copy -->
        <p
          class="font-sans mt-4 leading-relaxed max-w-xl"
          style="font-size: clamp(0.9375rem, 1.2vw, 1.0625rem); color: rgba(255,255,255,0.82);"
        >
          StratumCore brings senior finance leadership and practical capability building
          to the resource sector — without the big-firm overhead.
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#services" class="btn-primary">Explore our services</a>
          <a href="#contact" class="btn-outline">Book a call</a>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. WHAT WE DO — Services
  ══════════════════════════════════════════════════════════ -->
  <section id="services" class="section-light" aria-label="Our services">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <!-- Section header -->
      <div class="mb-16 fade-up">
        <p class="page-label mb-4" style="color: var(--accent);">Our services</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3.5vw, 3rem); letter-spacing: -0.025em; max-width: 28rem; line-height: 1.1;"
        >
          End-to-end advisory, built for the mining sector.
        </h2>
      </div>

      <!-- Cards grid -->
      <div class="grid md:grid-cols-3 gap-0 md:gap-px" style="background: var(--hairline);">
        <!-- Each card sits on white, gap-px between creates a hairline divider effect -->

        <!-- Card 1: Cost Reduction -->
        <article
          class="service-card-home bg-white p-8 lg:p-10 flex flex-col fade-up group"
        >
          <p
            class="font-sans font-bold mb-6"
            style="font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);"
          >01</p>
          <h3
            class="font-serif font-bold text-body mb-4"
            style="font-size: clamp(1.2rem, 1.8vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.15;"
          >
            Cost Reduction
          </h3>
          <p
            class="font-sans leading-relaxed flex-1 mb-8"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.7;"
          >
            15%+ productivity and unit cost gains from your existing operation —
            clarity, priorities, and a board-ready savings case.
          </p>
          <a
            href="/cost-reduction"
            class="font-sans font-bold inline-flex items-center gap-2 group-hover:gap-3 card-link"
            style="font-size: 0.875rem; color: var(--accent); text-decoration: none; letter-spacing: 0.01em;"
          >
            Learn more
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="transition: transform 0.2s ease;">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </article>

        <!-- Card 2: Financial Control -->
        <article
          class="service-card-home bg-white p-8 lg:p-10 flex flex-col fade-up group"
        >
          <p
            class="font-sans font-bold mb-6"
            style="font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);"
          >02</p>
          <h3
            class="font-serif font-bold text-body mb-4"
            style="font-size: clamp(1.2rem, 1.8vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.15;"
          >
            Financial Control
          </h3>
          <p
            class="font-sans leading-relaxed flex-1 mb-8"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.7;"
          >
            Get control of operational spend, real visibility into performance, and the
            governance to scale without bottlenecks.
          </p>
          <a
            href="/financial-control-governance"
            class="font-sans font-bold inline-flex items-center gap-2 group-hover:gap-3 card-link"
            style="font-size: 0.875rem; color: var(--accent); text-decoration: none; letter-spacing: 0.01em;"
          >
            Learn more
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="transition: transform 0.2s ease;">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </article>

        <!-- Card 3: Finance Team Building -->
        <article
          class="service-card-home bg-white p-8 lg:p-10 flex flex-col fade-up group"
        >
          <p
            class="font-sans font-bold mb-6"
            style="font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);"
          >03</p>
          <h3
            class="font-serif font-bold text-body mb-4"
            style="font-size: clamp(1.2rem, 1.8vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.15;"
          >
            Finance Team Building
          </h3>
          <p
            class="font-sans leading-relaxed flex-1 mb-8"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.7;"
          >
            Build a finance team that drives decisions — leadership development and the
            Finance Business Partner Academy.
          </p>
          <a
            href="/finance-team-building"
            class="font-sans font-bold inline-flex items-center gap-2 group-hover:gap-3 card-link"
            style="font-size: 0.875rem; color: var(--accent); text-decoration: none; letter-spacing: 0.01em;"
          >
            Learn more
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="transition: transform 0.2s ease;">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </article>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. HOW WE WORK
  ══════════════════════════════════════════════════════════ -->
  <section
    class="section-alt relative overflow-hidden"
    aria-label="Our approach"
  >
    <div class="max-w-site mx-auto px-6 lg:px-10 relative z-10">

      <!-- Section header -->
      <div class="mb-16 lg:mb-20 fade-up">
        <p class="page-label mb-4">Our approach</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3.5vw, 3rem); letter-spacing: -0.025em; max-width: 32rem; line-height: 1.1;"
        >
          Senior expertise. No juniors. No overhead.
        </h2>
      </div>

      <!-- Three steps -->
      <div class="grid md:grid-cols-3 gap-12 lg:gap-16">

        <!-- Step 1 -->
        <div class="fade-up">
          <p
            class="font-sans font-bold mb-4 block"
            style="font-size: 3.5rem; line-height: 1; letter-spacing: -0.04em; color: var(--accent);"
            aria-hidden="true"
          >01</p>
          <h3
            class="font-serif font-bold text-body mb-3"
            style="font-size: clamp(1.125rem, 1.6vw, 1.375rem); letter-spacing: -0.015em;"
          >
            Understand
          </h3>
          <p
            class="font-sans leading-relaxed"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;"
          >
            We start with your actual problem, not a packaged solution.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="fade-up">
          <p
            class="font-sans font-bold mb-4 block"
            style="font-size: 3.5rem; line-height: 1; letter-spacing: -0.04em; color: var(--accent);"
            aria-hidden="true"
          >02</p>
          <h3
            class="font-serif font-bold text-body mb-3"
            style="font-size: clamp(1.125rem, 1.6vw, 1.375rem); letter-spacing: -0.015em;"
          >
            Design
          </h3>
          <p
            class="font-sans leading-relaxed"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;"
          >
            We build the approach around your business, team, and constraints.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="fade-up">
          <p
            class="font-sans font-bold mb-4 block"
            style="font-size: 3.5rem; line-height: 1; letter-spacing: -0.04em; color: var(--accent);"
            aria-hidden="true"
          >03</p>
          <h3
            class="font-serif font-bold text-body mb-3"
            style="font-size: clamp(1.125rem, 1.6vw, 1.375rem); letter-spacing: -0.015em;"
          >
            Deliver
          </h3>
          <p
            class="font-sans leading-relaxed"
            style="font-size: 0.9375rem; color: var(--body); line-height: 1.75;"
          >
            We work alongside your people to make the change stick.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. ABOUT TEASER
  ══════════════════════════════════════════════════════════ -->
  <section class="section-light" aria-label="About StratumCore">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start fade-up">

        <!-- Left -->
        <div>
          <p class="page-label mb-5" style="color: var(--accent);">About StratumCore</p>
          <h2
            class="font-serif font-bold text-body mb-6"
            style="font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.025em; line-height: 1.15; max-width: 26rem;"
          >
            Led by people who have sat in your chair.
          </h2>
          <div
            class="font-sans leading-relaxed mb-8"
            style="font-size: 1rem; color: var(--body); line-height: 1.8;"
          >
            <p>
              StratumCore is led by two principals — Wen Khong and Calvin Yong — each with decades
              of hands-on experience inside mining and resource businesses. Between them, they bring
              senior finance leadership, operational insight, and a proven track record of delivering
              real change.
            </p>
          </div>
          <a
            href="/about"
            class="font-sans font-bold inline-flex items-center gap-2 card-link"
            style="font-size: 0.9375rem; color: var(--accent); text-decoration: none; letter-spacing: 0.01em;"
          >
            Meet the team
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <!-- Right — two principal credentials -->
        <div class="flex flex-col gap-6">

          <div class="card p-6" style="border-left: 2px solid var(--accent);">
            <p class="font-sans font-bold text-body mb-1" style="font-size: 1rem; letter-spacing: -0.01em;">Wen Khong</p>
            <p class="font-sans mb-3" style="font-size: 0.8125rem; color: var(--accent); letter-spacing: 0.04em; text-transform: uppercase; font-weight: 700;">Principal</p>
            <p class="font-sans" style="font-size: 0.9375rem; color: var(--body); line-height: 1.7;">
              Two decades in senior finance roles across BHP, Wesfarmers, BUMA, and Ernst &amp; Young.
              Deep expertise in finance transformation and CFO advisory.
            </p>
          </div>

          <div class="card p-6" style="border-left: 2px solid var(--accent);">
            <p class="font-sans font-bold text-body mb-1" style="font-size: 1rem; letter-spacing: -0.01em;">Calvin Yong</p>
            <p class="font-sans mb-3" style="font-size: 0.8125rem; color: var(--accent); letter-spacing: 0.04em; text-transform: uppercase; font-weight: 700;">Principal</p>
            <p class="font-sans" style="font-size: 0.9375rem; color: var(--body); line-height: 1.7;">
              Extensive experience across BMA, BHP, Bankwest, and CS Gas. Specialist in leadership
              development and finance business partnering.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       5. CONTACT — form (Web3Forms)
  ══════════════════════════════════════════════════════════ -->
  <section
    id="contact"
    class="section-light section-divided relative"
    aria-label="Contact"
  >
    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">

        <!-- Left: pitch -->
        <div class="lg:col-span-5 fade-up">
          <h2
            class="font-serif font-bold"
            style="font-size: clamp(1.75rem, 3.5vw, 3rem); color: var(--ink); letter-spacing: -0.025em; line-height: 1.15; max-width: 30rem;"
          >
            Ready to have a different kind of finance conversation?
          </h2>
          <p
            class="font-sans mt-6 leading-relaxed"
            style="font-size: 1.0625rem; color: var(--body); line-height: 1.8; max-width: 28rem;"
          >
            Tell us a little about your business and what&rsquo;s prompting the conversation.
            We&rsquo;ll come back to you within one business day to set up a call.
          </p>
          <p class="font-sans mt-8" style="font-size: 0.9375rem; color: var(--body);">
            Prefer email?
            <a href="mailto:wen@stratumcore.com.au" class="inline-link">wen@stratumcore.com.au</a>
          </p>
          <p class="font-sans mt-2" style="font-size: 0.875rem; color: var(--muted);">
            Brisbane, QLD, Australia
          </p>
        </div>

        <!-- Right: form card -->
        <div class="lg:col-span-7 fade-up">
          <div class="form-card">

            <form id="contact-form" novalidate>
              <!-- Web3Forms config -->
              <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              <input type="hidden" name="subject" value="New enquiry — stratumcore.com.au" />
              <input type="hidden" name="from_name" value="StratumCore website" />
              <!-- Honeypot (spam trap) -->
              <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

              <div class="grid sm:grid-cols-2 gap-5">
                <div class="field">
                  <label for="f-name">Name <span class="req" aria-hidden="true">*</span></label>
                  <input id="f-name" name="name" type="text" autocomplete="name" required aria-required="true" />
                  <p class="err" data-err-for="f-name" hidden>Please enter your name.</p>
                </div>

                <div class="field">
                  <label for="f-company">Company</label>
                  <input id="f-company" name="company" type="text" autocomplete="organization" />
                </div>

                <div class="field">
                  <label for="f-email">Email <span class="req" aria-hidden="true">*</span></label>
                  <input id="f-email" name="email" type="email" autocomplete="email" required aria-required="true" inputmode="email" />
                  <p class="err" data-err-for="f-email" hidden>Please enter a valid email address.</p>
                </div>

                <div class="field">
                  <label for="f-phone">Phone</label>
                  <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
                </div>

                <div class="field sm:col-span-2">
                  <label for="f-message">How can we help?</label>
                  <textarea id="f-message" name="message" rows="4" placeholder="A little about your business and what&rsquo;s prompting the conversation."></textarea>
                </div>
              </div>

              <button type="submit" class="form-submit" id="form-submit-btn">
                <span class="form-submit__label">Send my enquiry</span>
                <svg class="form-submit__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <p class="form-fineprint">We&rsquo;ll only use your details to arrange the call. No lists, no spam.</p>

              <!-- Live region for form-level status -->
              <p class="form-status form-status--error" id="form-error" role="alert" hidden></p>
            </form>

            <!-- Success state (revealed after submit) -->
            <div class="form-success" id="form-success" hidden role="status">
              <div class="form-success__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 16 16" fill="none"><path d="M2 8.5l3.5 3.5L14 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="form-success__h">Thanks &mdash; message received.</h3>
              <p class="form-success__b">We&rsquo;ll be in touch within one business day to set up your call.</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />

</BaseLayout>

<style>
  /* Text links with arrow — specific transitions only */
  .card-link {
    transition: gap 0.2s ease, color 0.15s ease;
  }
  .card-link svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .card-link:hover svg,
  .service-card-home:hover .card-link svg {
    transform: translateX(3px);
  }

  /* Service card top-border reveal on hover */
  .service-card-home {
    border-top: 2px solid var(--hairline);
    transition: border-color 0.22s ease;
  }
  .service-card-home:hover {
    border-top-color: var(--accent);
  }
  .service-card-home:hover a svg {
    transform: translateX(3px);
  }

  /* ── Contact form ──────────────────────────────────────────── */
  .form-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--accent);
    border-radius: 8px;
    padding: 1.75rem 1.5rem 1.5rem;
  }
  @media (min-width: 640px) { .form-card { padding: 2.25rem; } }

  .field { display: flex; flex-direction: column; }
  .field label {
    font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700;
    letter-spacing: 0.02em; color: var(--ink); margin-bottom: 0.4rem;
  }
  .field .req { color: var(--accent); }
  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 0.9688rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 5px;
    padding: 0.85rem 1rem;
    min-height: 52px;
    width: 100%;
    transition: border-color var(--dur-mid) var(--ease), background var(--dur-mid) var(--ease), box-shadow var(--dur-mid) var(--ease);
  }
  .field textarea { min-height: 110px; resize: vertical; line-height: 1.6; }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--muted); }
  .field input:hover,
  .field textarea:hover { border-color: var(--muted); }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .field input[aria-invalid="true"],
  .field textarea[aria-invalid="true"] {
    border-color: #C0392B;
    box-shadow: 0 0 0 3px rgba(192,57,43,0.12);
  }
  .field .err {
    font-family: var(--font-body); font-size: 0.8125rem; color: #C0392B; margin-top: 0.35rem;
  }

  /* Honeypot — visually hidden */
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .form-submit {
    margin-top: 1.6rem;
    width: 100%;
    min-height: 52px;
    font-family: var(--font-body); font-weight: 700; font-size: 1rem; letter-spacing: 0.01em;
    color: var(--accent-fg); background: var(--accent);
    border: none; border-radius: 5px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    transition: background 0.18s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1);
  }
  .form-submit:hover { background: var(--accent-strong); transform: translateY(-2px); }
  .form-submit:active { transform: translateY(0); }
  .form-submit:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .form-submit[disabled] { opacity: 0.6; cursor: progress; transform: none; }
  .form-submit__arrow { transition: transform 0.2s ease; }
  .form-submit:hover .form-submit__arrow { transform: translateX(3px); }

  .form-fineprint {
    font-family: var(--font-body); font-size: 0.8125rem; color: var(--muted);
    text-align: center; margin-top: 0.95rem; line-height: 1.5;
  }
  .form-status { font-family: var(--font-body); font-size: 0.9rem; margin-top: 1rem; text-align: center; }
  .form-status--error { color: #C0392B; }

  /* Success state */
  .form-success { text-align: center; padding: 2.5rem 1rem; }
  .form-success__icon {
    width: 56px; height: 56px; margin: 0 auto 1.1rem;
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); background: var(--accent-soft); border-radius: 50%;
  }
  .form-success__h {
    font-family: var(--font-body); font-weight: 700; color: var(--ink);
    font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: 0.6rem;
  }
  .form-success__b {
    font-family: var(--font-body); font-size: 1rem; color: var(--body);
    line-height: 1.7; max-width: 26rem; margin: 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-submit, .form-submit__arrow { transition: none; }
  }
</style>

<script>
  // Scroll reveal
  // Scroll reveal. Grouped siblings stagger off --i so cards arrive in
  // sequence rather than together. The hero carries no .fade-up at all, so it
  // paints at full opacity on first frame.
  const reveal = () => {
    const items = [...document.querySelectorAll('.fade-up')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('visible'));
      return;
    }
    items.forEach(el => {
      const sibs = [...(el.parentElement?.children ?? [])].filter(n => n.classList.contains('fade-up'));
      if (sibs.length > 1) el.style.setProperty('--i', String(sibs.indexOf(el)));
    });

    // Anything already on screen at load is shown immediately, with no
    // transition, so the first viewport is never caught mid-fade.
    const vh = window.innerHeight;
    items.forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) { el.style.setProperty('--i', '0'); el.classList.add('instant', 'visible'); }
    });

    // rootMargin fires the reveal a screen-worth early, so an element is
    // already at full opacity by the time it is actually scrolled into view.
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        // If it is already well inside the viewport, a fast scroll outran the
        // observer — skip the transition rather than fade it in late.
        const r = e.target.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.75) e.target.classList.add('instant');
        e.target.classList.add('visible');
        io.unobserve(e.target);
      });
    }, { threshold: 0, rootMargin: '0px 0px 45% 0px' });
    items.forEach(el => { if (!el.classList.contains('visible')) io.observe(el); });
  };
  reveal();

  // ── Contact form: validation + Web3Forms submit + success ────
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const nameEl    = document.getElementById('f-name')    as HTMLInputElement;
    const emailEl   = document.getElementById('f-email')   as HTMLInputElement;
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;
    const errBox    = document.getElementById('form-error') as HTMLParagraphElement;
    const successEl = document.getElementById('form-success') as HTMLDivElement;

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showFieldError = (el: HTMLInputElement, show: boolean) => {
      el.setAttribute('aria-invalid', String(show));
      const msg = document.querySelector(`[data-err-for="${el.id}"]`) as HTMLElement | null;
      if (msg) msg.hidden = !show;
    };

    // Clear a field's error as the user corrects it
    [nameEl, emailEl].forEach(el =>
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') showFieldError(el, false); })
    );

    const validate = () => {
      let ok = true;
      if (!nameEl.value.trim()) { showFieldError(nameEl, true); ok = false; }
      if (!emailRe.test(emailEl.value.trim())) { showFieldError(emailEl, true); ok = false; }
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.hidden = true;

      if (!validate()) {
        const firstBad = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        firstBad?.focus();
        return;
      }

      submitBtn.disabled = true;
      const original = submitBtn.querySelector('.form-submit__label')!.textContent;
      submitBtn.querySelector('.form-submit__label')!.textContent = 'Sending…';

      try {
        const data = new FormData(form);
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && (json as any).success) {
          form.hidden = true;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error((json as any).message || 'Submission failed');
        }
      } catch (err) {
        errBox.textContent = 'Something went wrong sending your message. Please email wen@stratumcore.com.au and we’ll sort it out.';
        errBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.querySelector('.form-submit__label')!.textContent = original;
      }
    });
  }
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://www.stratumcore.com.au/#organisation",
      "name": "StratumCore",
      "url": "https://www.stratumcore.com.au",
      "email": "wen@stratumcore.com.au",
      "telephone": "+61451954594",
      "description": "Fixed-fee mining cost diagnostic that benchmarks your cost per tonne and delivers a board-ready savings case in five weeks.",
      "founder": { "@type": "Person", "name": "Wen Khong" },
      "areaServed": "Australia",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Brisbane",
        "addressRegion": "QLD",
        "addressCountry": "AU"
      },
      "knowsAbout": [
        "mining cost reduction",
        "cost per tonne benchmarking",
        "cost diagnostic",
        "mining finance",
        "CFO advisory"
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.stratumcore.com.au/#cost-diagnostic",
      "name": "Mining Cost Diagnostic",
      "serviceType": "Cost diagnostic and savings benchmarking",
      "provider": { "@id": "https://www.stratumcore.com.au/#organisation" },
      "areaServed": "Australia",
      "description": "A fixed-fee, five-week diagnostic that benchmarks your cost per tonne against the field and delivers a prioritised, board-ready savings case."
    },
    {
      "@type": "Person",
      "@id": "https://www.stratumcore.com.au/about/#wen-khong",
      "name": "Wen Khong",
      "jobTitle": "Principal",
      "worksFor": { "@type": "Organization", "name": "StratumCore" },
      "alumniOf": ["BHP", "Wesfarmers", "BUMA", "Ernst & Young"],
      "url": "https://www.stratumcore.com.au/about"
    },
    {
      "@type": "Person",
      "@id": "https://www.stratumcore.com.au/about/#calvin-yong",
      "name": "Calvin Yong",
      "jobTitle": "Principal",
      "worksFor": { "@type": "Organization", "name": "StratumCore" },
      "alumniOf": ["BMA", "BHP", "Bankwest", "CS Gas"],
      "url": "https://www.stratumcore.com.au/about"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.stratumcore.com.au/" }
      ]
    }
  ]
});

// Web3Forms access key — replace this placeholder with your own free key from https://web3forms.com
const WEB3FORMS_ACCESS_KEY = "8274a80a-9baa-44f7-978c-3226595639e5";
---

<BaseLayout
  title="Cut Your Cost per Tonne 15–29% | Mining Cost Diagnostic | StratumCore"
  description="A fixed-fee mining cost diagnostic that benchmarks your $/tonne against the field and delivers a board-ready savings case in 5 weeks. Run by experienced partners. Book a 30-minute cost review."
  canonical="https://www.stratumcore.com.au/"
  ogImage="https://www.stratumcore.com.au/og-image-home.png"
  ogImageAlt="StratumCore — Mining Cost Diagnostic"
  jsonLd={jsonLd}
>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════
       1. HERO — single offer: the cost diagnostic
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark relative overflow-hidden flex flex-col justify-center"
    aria-label="Take 15 to 29 percent out of your cost per tonne"
    style="
      min-height: 100svh;
      background-color: #1C1C1E;
      background-image:
        radial-gradient(ellipse 65% 70% at 90% 5%,  rgba(0,201,187,0.07) 0%, transparent 55%),
        radial-gradient(ellipse 40% 50% at 5%  90%, rgba(212,117,26,0.04) 0%, transparent 50%),
        linear-gradient(rgba(255,255,255,0.013) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.013) 1px, transparent 1px);
      background-size: auto, auto, 72px 72px, 72px 72px;
    "
  >
    <div class="relative z-10 max-w-site mx-auto px-6 lg:px-10 w-full pt-[calc(72px+2.5rem)] pb-16 lg:pb-20">

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">

        <!-- Left: message -->
        <div class="lg:col-span-6 fade-up">
          <p class="page-label mb-5">Fixed-fee cost diagnostic &nbsp;·&nbsp; Mining &amp; resources</p>
          <span class="teal-rule mb-8 block"></span>

          <!-- 1. Headline -->
          <h1
            class="font-serif font-bold text-white mb-0"
            style="font-size: clamp(2.35rem, 4.6vw, 4.25rem); letter-spacing: -0.03em; line-height: 1.04;"
          >
            Take 15&ndash;29% out of your cost per tonne&mdash;<span style="color: #00C9BB;">without adding headcount.</span>
          </h1>

          <!-- 2. Sub-headline -->
          <p
            class="font-serif mt-7 leading-relaxed"
            style="font-size: clamp(1rem, 1.35vw, 1.1875rem); color: rgba(255,255,255,0.62); line-height: 1.7; max-width: 34rem;"
          >
            A fixed-fee cost diagnostic that benchmarks your $/t against the field and hands you a
            board-ready savings case in <strong style="color: rgba(255,255,255,0.92); font-weight: 700;">5 weeks</strong>.
            Run by experienced partners&mdash;not junior staff.
          </p>

          <!-- 5. Primary CTA → scrolls to contact form -->
          <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-4">
            <a href="#contact" class="btn-primary cta-lg">Book my cost review</a>
            <span class="font-serif" style="font-size: 0.875rem; color: rgba(255,255,255,0.45); line-height: 1.5; max-width: 18rem;">
              30&nbsp;minutes. No obligation. We come prepared with a savings range for your operation.
            </span>
          </div>

          <p
            class="font-serif mt-6 inline-flex items-start gap-2.5"
            style="font-size: 0.875rem; color: rgba(255,255,255,0.78); line-height: 1.5;"
          >
            <span aria-hidden="true" style="color: #00C9BB; flex-shrink: 0; margin-top: 0.05em;">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8.5l3.5 3.5L14 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>If we don&rsquo;t identify at least <strong style="font-weight:700;">$50K in addressable savings</strong>, the diagnostic is free.</span>
          </p>
        </div>

        <!-- 3. Hero proof asset (proof 1) — eager-loaded -->
        <div class="lg:col-span-6 fade-up" style="transition-delay: 90ms;">
          <figure class="chart-exhibit chart-exhibit--hero">
            <div class="chart-scroll">
              <img
                src="/Hero-proof1.png"
                width="1280"
                height="720"
                alt="Cost waterfall showing a clear pathway to a 29% reduction in FY26 unit cost, from 1.37 to 1.06 US$/lb across named initiatives."
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="chart-img"
              />
            </div>
            <figcaption class="chart-cap">
              <span class="chart-cap__swipe lg:hidden" aria-hidden="true">Swipe to explore &rarr;&nbsp;&nbsp;</span>
              Example output: a costed, initiative-by-initiative pathway to lower unit cost.
              <a href="/Hero-proof1.png" target="_blank" rel="noopener" class="chart-cap__full">Open full chart&nbsp;&nbsp;&#8599;</a>
            </figcaption>
          </figure>
        </div>

      </div>
    </div>

    <!-- Bottom fade to next section -->
    <div class="absolute bottom-0 inset-x-0 h-20 pointer-events-none"
         style="background: linear-gradient(to bottom, transparent, rgba(28,28,30,0.6));"></div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. CTA BLOCK + HOW WE FIND THE SAVINGS (proof 2)
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 lg:py-28" aria-label="How it works">
    <div class="max-w-site mx-auto px-6 lg:px-10">

      <!-- 4a. CTA block -->
      <div class="max-w-3xl fade-up">
        <p class="page-label mb-4" style="color: #00C9BB;">What you get</p>
        <h2
          class="font-serif font-bold text-body"
          style="font-size: clamp(1.75rem, 3.5vw, 3rem); letter-spacing: -0.025em; line-height: 1.12;"
        >
          Know where your savings are before you spend a dollar.
        </h2>
        <p
          class="font-serif mt-6 leading-relaxed"
          style="font-size: 1.0625rem; color: rgba(34,34,34,0.66); line-height: 1.8;"
        >
          Book a 30-minute cost review. We&rsquo;ll show you the likely savings range for your operation and
          exactly how the diagnostic works. If we don&rsquo;t identify at least $50K in addressable savings,
          the diagnostic is free.
        </p>
      </div>

      <!-- Three quick "what you get" beats -->
      <div class="grid sm:grid-cols-3 gap-px mt-14 fade-up" style="background: #E8E8E8;">
        <div class="bg-white p-7 lg:p-8 deliverable">
          <p class="deliverable__k">01</p>
          <h3 class="deliverable__h">Benchmarked $/t</h3>
          <p class="deliverable__b">Your cost per tonne placed against the field, broken down to where you actually sit high.</p>
        </div>
        <div class="bg-white p-7 lg:p-8 deliverable">
          <p class="deliverable__k">02</p>
          <h3 class="deliverable__h">Prioritised initiatives</h3>
          <p class="deliverable__b">Every saving ranked by dollar value against the effort to capture it&mdash;biggest wins first.</p>
        </div>
        <div class="bg-white p-7 lg:p-8 deliverable">
          <p class="deliverable__k">03</p>
          <h3 class="deliverable__h">Board-ready case</h3>
          <p class="deliverable__b">A defensible savings case in 5 weeks&mdash;numbers that withstand executive and board scrutiny.</p>
        </div>
      </div>

      <!-- 4b. Second proof beat (proof 2) — lazy-loaded, below the fold -->
      <div class="mt-20 lg:mt-28 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-5 fade-up">
          <p class="page-label mb-4" style="color: #00C9BB;">How we find the savings</p>
          <h2
            class="font-serif font-bold text-body"
            style="font-size: clamp(1.6rem, 3vw, 2.5rem); letter-spacing: -0.025em; line-height: 1.14; max-width: 22rem;"
          >
            We rank every initiative by value against effort.
          </h2>
          <p
            class="font-serif mt-5 leading-relaxed"
            style="font-size: 1rem; color: rgba(34,34,34,0.64); line-height: 1.8; max-width: 28rem;"
          >
            We rank every initiative by dollar value against the effort to capture it&mdash;so you act on
            the biggest, easiest wins first, and see exactly what each one is worth before committing.
          </p>
        </div>

        <div class="lg:col-span-7 fade-up" style="transition-delay: 90ms;">
          <figure class="chart-exhibit chart-exhibit--light">
            <div class="chart-scroll">
              <img
                src="/Hero-proof2.png"
                width="1280"
                height="720"
                alt="Initiatives prioritisation map plotting each savings initiative by risk against difficulty of implementation, with bubble size showing the size of savings."
                loading="lazy"
                decoding="async"
                class="chart-img"
              />
            </div>
            <figcaption class="chart-cap">
              <span class="chart-cap__swipe lg:hidden" aria-hidden="true">Swipe to explore &rarr;&nbsp;&nbsp;</span>
              Savings initiatives ranked by value, effort and risk.
              <a href="/Hero-proof2.png" target="_blank" rel="noopener" class="chart-cap__full">Open full chart&nbsp;&nbsp;&#8599;</a>
            </figcaption>
          </figure>
        </div>
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. TRUST STRIP — experienced partners (reinforces the offer)
  ══════════════════════════════════════════════════════════ -->
  <section
    class="hero-dark py-16 lg:py-20 relative overflow-hidden"
    aria-label="Who runs the diagnostic"
    style="background-color: #1C1C1E; background-image: radial-gradient(ellipse 50% 60% at 50% 100%, rgba(0,201,187,0.05) 0%, transparent 60%);"
  >
    <div class="max-w-site mx-auto px-6 lg:px-10 relative z-10">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center fade-up">
        <div class="lg:col-span-4">
          <p class="page-label mb-3">Run by partners</p>
          <p class="font-serif font-bold text-white" style="font-size: clamp(1.25rem, 2vw, 1.6rem); letter-spacing: -0.02em; line-height: 1.2;">
            Senior people only. No juniors learning on your site.
          </p>
        </div>
        <div class="lg:col-span-8 grid sm:grid-cols-2 gap-x-10 gap-y-6">
          <div>
            <p class="font-serif font-bold text-white" style="font-size: 1rem;">Wen Khong</p>
            <p class="font-serif" style="font-size: 0.9375rem; color: rgba(255,255,255,0.5); line-height: 1.65;">
              Two decades in senior finance across BHP, Wesfarmers, BUMA and Ernst &amp; Young.
            </p>
          </div>
          <div>
            <p class="font-serif font-bold text-white" style="font-size: 1rem;">Calvin Yong</p>
            <p class="font-serif" style="font-size: 0.9375rem; color: rgba(255,255,255,0.5); line-height: 1.65;">
              Operational and commercial experience across BMA, BHP, Bankwest and CS Gas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. CONTACT FORM
  ══════════════════════════════════════════════════════════ -->
  <section id="contact" class="py-20 lg:py-28" style="background: #F2F2F2;" aria-label="Book your cost review">
    <div class="max-w-site mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">

        <!-- Left: pitch -->
        <div class="lg:col-span-5 fade-up">
          <p class="page-label mb-4" style="color: #00C9BB;">Book your cost review</p>
          <h2
            class="font-serif font-bold text-body"
            style="font-size: clamp(1.85rem, 3.5vw, 3rem); letter-spacing: -0.025em; line-height: 1.12;"
          >
            Book my cost review.
          </h2>
          <p class="font-serif mt-6 leading-relaxed" style="font-size: 1.0625rem; color: rgba(34,34,34,0.66); line-height: 1.8; max-width: 30rem;">
            Tell us a little about your operation and we&rsquo;ll come to the call with a likely savings
            range and a clear walk-through of the diagnostic.
          </p>

          <ul class="mt-8 space-y-3" role="list">
            {[
              '30-minute call, no obligation',
              'A savings range for your operation',
              '$50K in addressable savings — or it’s free',
            ].map((item) => (
              <li class="font-serif flex items-start gap-3" style="font-size: 0.9688rem; color: rgba(34,34,34,0.78); line-height: 1.55;">
                <span aria-hidden="true" style="color:#00C9BB; flex-shrink:0; margin-top:0.1em;">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8.5l3.5 3.5L14 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>

          <p class="font-serif mt-8" style="font-size: 0.875rem; color: rgba(34,34,34,0.5);">
            Prefer email? <a href="mailto:wen@stratumcore.com.au" style="color:#0e8f86; text-decoration: underline; text-underline-offset: 2px;">wen@stratumcore.com.au</a>
          </p>
        </div>

        <!-- Right: form card -->
        <div class="lg:col-span-7 fade-up" style="transition-delay: 80ms;">
          <div class="form-card">

            <form id="cost-review-form" novalidate>
              <!-- Web3Forms config -->
              <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              <input type="hidden" name="subject" value="New cost review request — stratumcore.com.au" />
              <input type="hidden" name="from_name" value="StratumCore website" />
              <!-- Honeypot (spam trap) -->
              <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

              <div class="grid sm:grid-cols-2 gap-5">
                <div class="field">
                  <label for="f-name">Name <span class="req" aria-hidden="true">*</span></label>
                  <input id="f-name" name="name" type="text" autocomplete="name" required aria-required="true" />
                  <p class="err" data-err-for="f-name" hidden>Please enter your name.</p>
                </div>

                <div class="field">
                  <label for="f-company">Company</label>
                  <input id="f-company" name="company" type="text" autocomplete="organization" />
                </div>

                <div class="field">
                  <label for="f-email">Email <span class="req" aria-hidden="true">*</span></label>
                  <input id="f-email" name="email" type="email" autocomplete="email" required aria-required="true" inputmode="email" />
                  <p class="err" data-err-for="f-email" hidden>Please enter a valid email address.</p>
                </div>

                <div class="field">
                  <label for="f-phone">Phone</label>
                  <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
                </div>

                <div class="field sm:col-span-2">
                  <label for="f-message">Tell me more&hellip;</label>
                  <textarea id="f-message" name="message" rows="4" placeholder="Commodity, rough production rate, and what&rsquo;s driving the cost question."></textarea>
                </div>
              </div>

              <button type="submit" class="form-submit" id="form-submit-btn">
                <span class="form-submit__label">Book my cost review</span>
                <svg class="form-submit__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <p class="form-fineprint">We&rsquo;ll only use your details to arrange the call. No lists, no spam.</p>

              <!-- Live region for form-level status -->
              <p class="form-status form-status--error" id="form-error" role="alert" hidden></p>
            </form>

            <!-- Success state (revealed after submit) -->
            <div class="form-success" id="form-success" hidden role="status">
              <div class="form-success__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 16 16" fill="none"><path d="M2 8.5l3.5 3.5L14 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="form-success__h">Request received.</h3>
              <p class="form-success__b">Thanks&mdash;we&rsquo;ll be in touch within one business day to lock in your 30-minute cost review.</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />

</BaseLayout>


<style>
  /* Larger hero CTA — meets ≥44px tap target */
  .cta-lg {
    padding: 0.95rem 2.1rem;
    font-size: 1rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
  }

  /* ── Chart exhibit ─────────────────────────────────────────── */
  .chart-exhibit {
    background: #FFFFFF;
    border-radius: 8px;
    padding: 0.5rem;
    box-shadow: 0 1px 1px rgba(28,28,30,0.04),
                0 12px 32px -8px rgba(28,28,30,0.28),
                0 2px 8px -2px rgba(0,201,187,0.10);
  }
  .chart-exhibit--light {
    box-shadow: 0 1px 1px rgba(28,28,30,0.04),
                0 14px 36px -10px rgba(28,28,30,0.18);
    border: 1px solid #EBEBEB;
  }
  .chart-scroll {
    border-radius: 5px;
    overflow: hidden;
  }
  .chart-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 5px;
  }
  .chart-cap {
    font-family: Georgia, serif;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(34,34,34,0.5);
    padding: 0.7rem 0.6rem 0.4rem;
  }
  /* hero exhibit caption sits on dark bg */
  .chart-exhibit--hero .chart-cap { color: rgba(255,255,255,0.42); }
  .chart-cap__full {
    color: #0e8f86;
    text-decoration: none;
    white-space: nowrap;
    font-weight: 700;
  }
  .chart-exhibit--hero .chart-cap__full { color: #00C9BB; }
  .chart-cap__full:hover { text-decoration: underline; text-underline-offset: 2px; }
  .chart-cap__swipe { color: #00C9BB; font-weight: 700; }

  /* On small screens, keep chart labels legible: scroll horizontally
     at a readable intrinsic width rather than shrinking the whole image. */
  @media (max-width: 767px) {
    .chart-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .chart-img { width: 720px; max-width: none; }
  }

  /* ── "What you get" deliverables ───────────────────────────── */
  .deliverable { border-top: 2px solid #E8E8E8; transition: border-color 0.22s ease; }
  .deliverable:hover { border-top-color: #00C9BB; }
  .deliverable__k {
    font-family: Georgia, serif; font-weight: 700; font-size: 0.6875rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: #00C9BB; margin-bottom: 1.1rem;
  }
  .deliverable__h {
    font-family: Georgia, serif; font-weight: 700; color: #222; margin-bottom: 0.6rem;
    font-size: 1.1875rem; letter-spacing: -0.015em; line-height: 1.2;
  }
  .deliverable__b {
    font-family: Georgia, serif; font-size: 0.9375rem; color: rgba(34,34,34,0.62); line-height: 1.7;
  }

  /* ── Form ──────────────────────────────────────────────────── */
  .form-card {
    background: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-top: 3px solid #00C9BB;
    border-radius: 8px;
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: 0 1px 2px rgba(28,28,30,0.03), 0 18px 40px -16px rgba(28,28,30,0.18);
  }
  @media (min-width: 640px) { .form-card { padding: 2.25rem; } }

  .field { display: flex; flex-direction: column; }
  .field label {
    font-family: Georgia, serif; font-size: 0.8125rem; font-weight: 700;
    letter-spacing: 0.02em; color: #1C1C1E; margin-bottom: 0.4rem;
  }
  .field .req { color: #00C9BB; }
  .field input,
  .field textarea {
    font-family: Georgia, serif;
    font-size: 0.9688rem;
    color: #1C1C1E;
    background: #F7F7F5;
    border: 1px solid #E0E0E0;
    border-radius: 5px;
    padding: 0.72rem 0.85rem;
    min-height: 46px;
    width: 100%;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .field textarea { min-height: 110px; resize: vertical; line-height: 1.6; }
  .field input::placeholder,
  .field textarea::placeholder { color: rgba(34,34,34,0.38); }
  .field input:hover,
  .field textarea:hover { border-color: #C9C9C9; }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    background: #FFFFFF;
    border-color: #00C9BB;
    box-shadow: 0 0 0 3px rgba(0,201,187,0.16);
  }
  .field input[aria-invalid="true"],
  .field textarea[aria-invalid="true"] {
    border-color: #C0392B;
    box-shadow: 0 0 0 3px rgba(192,57,43,0.12);
  }
  .field .err {
    font-family: Georgia, serif; font-size: 0.8125rem; color: #C0392B; margin-top: 0.35rem;
  }

  /* Honeypot — visually hidden */
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .form-submit {
    margin-top: 1.6rem;
    width: 100%;
    min-height: 52px;
    font-family: Georgia, serif; font-weight: 700; font-size: 1rem; letter-spacing: 0.01em;
    color: #1C1C1E; background: #00C9BB;
    border: none; border-radius: 5px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    transition: background 0.18s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.18s ease;
    box-shadow: 0 4px 14px rgba(0,201,187,0.22);
  }
  .form-submit:hover { background: #00dfd0; transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,201,187,0.3); }
  .form-submit:active { transform: translateY(0); }
  .form-submit:focus-visible { outline: 2px solid #1C1C1E; outline-offset: 3px; }
  .form-submit[disabled] { opacity: 0.6; cursor: progress; transform: none; }
  .form-submit__arrow { transition: transform 0.2s ease; }
  .form-submit:hover .form-submit__arrow { transform: translateX(3px); }

  .form-fineprint {
    font-family: Georgia, serif; font-size: 0.8125rem; color: rgba(34,34,34,0.45);
    text-align: center; margin-top: 0.95rem; line-height: 1.5;
  }
  .form-status { font-family: Georgia, serif; font-size: 0.9rem; margin-top: 1rem; text-align: center; }
  .form-status--error { color: #C0392B; }

  /* Success state */
  .form-success { text-align: center; padding: 2.5rem 1rem; }
  .form-success__icon {
    width: 56px; height: 56px; margin: 0 auto 1.1rem;
    display: flex; align-items: center; justify-content: center;
    color: #00C9BB; background: rgba(0,201,187,0.12); border-radius: 50%;
  }
  .form-success__h {
    font-family: Georgia, serif; font-weight: 700; color: #1C1C1E;
    font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: 0.6rem;
  }
  .form-success__b {
    font-family: Georgia, serif; font-size: 1rem; color: rgba(34,34,34,0.66);
    line-height: 1.7; max-width: 26rem; margin: 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-submit, .form-submit__arrow { transition: none; }
  }
</style>


<script>
  // ── Scroll reveal (matches existing site behaviour) ──────────
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
    });
  }, { threshold: 0.07, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
  setTimeout(() => document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible')), 80);

  // ── Contact form: validation + Web3Forms submit + success ────
  const form = document.getElementById('cost-review-form') as HTMLFormElement | null;
  if (form) {
    const nameEl    = document.getElementById('f-name')    as HTMLInputElement;
    const emailEl   = document.getElementById('f-email')   as HTMLInputElement;
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;
    const errBox    = document.getElementById('form-error') as HTMLParagraphElement;
    const successEl = document.getElementById('form-success') as HTMLDivElement;

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showFieldError = (el: HTMLInputElement, show: boolean) => {
      el.setAttribute('aria-invalid', String(show));
      const msg = document.querySelector(`[data-err-for="${el.id}"]`) as HTMLElement | null;
      if (msg) msg.hidden = !show;
    };

    // Clear a field's error as the user corrects it
    [nameEl, emailEl].forEach(el =>
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') showFieldError(el, false); })
    );

    const validate = () => {
      let ok = true;
      if (!nameEl.value.trim()) { showFieldError(nameEl, true); ok = false; }
      if (!emailRe.test(emailEl.value.trim())) { showFieldError(emailEl, true); ok = false; }
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.hidden = true;

      if (!validate()) {
        const firstBad = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        firstBad?.focus();
        return;
      }

      submitBtn.disabled = true;
      const original = submitBtn.querySelector('.form-submit__label')!.textContent;
      submitBtn.querySelector('.form-submit__label')!.textContent = 'Sending…';

      try {
        const data = new FormData(form);
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && (json as any).success) {
          form.hidden = true;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error((json as any).message || 'Submission failed');
        }
      } catch (err) {
        errBox.textContent = 'Something went wrong sending your request. Please email wen@stratumcore.com.au and we’ll sort it out.';
        errBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.querySelector('.form-submit__label')!.textContent = original;
      }
    });
  }
</script>
